{
  "name": "crimson-desert-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run generate:all",
    "build": "astro build",
    "prebuild": "npm run generate:all",
    "postbuild": "node scripts/prepare-deployment.mjs",
    "preview": "astro preview",
    "generate:database": "node scripts/generate-content-database.mjs",
    "generate:completion": "node scripts/generate-completion-data.mjs",
    "generate:details": "node scripts/generate-guide-details.mjs",
    "generate:catalogue": "node scripts/generate-collectible-catalogue.mjs",
    "generate:v1": "node scripts/generate-v1-readiness.mjs",
    "generate:all": "npm run generate:database && npm run generate:completion && npm run generate:details && npm run generate:catalogue && npm run generate:v1",
    "audit:content": "node scripts/content-audit.mjs",
    "audit:world": "node scripts/world-data-audit.mjs",
    "audit:completion": "node scripts/completion-data-audit.mjs",
    "audit:database": "node scripts/content-database-audit.mjs",
    "audit:atlas": "node scripts/atlas-data-audit.mjs",
    "audit:details": "node scripts/guide-detail-audit.mjs",
    "audit:catalogue": "node scripts/collectible-catalogue-audit.mjs",
    "audit:characters": "node scripts/character-build-audit.mjs",
    "audit:technical": "node scripts/technical-data-audit.mjs",
    "audit:theme": "node scripts/light-theme-contrast-audit.mjs",
    "audit:site-theme": "node scripts/site-theme-audit.mjs",
    "audit:v1": "node scripts/v1-readiness-audit.mjs",
    "audit:all": "npm run audit:content && npm run audit:world && npm run audit:completion && npm run audit:database && npm run audit:atlas && npm run audit:details && npm run audit:catalogue && npm run audit:characters && npm run audit:technical && npm run audit:theme && npm run audit:site-theme && npm run audit:v1",
    "test:completion": "node scripts/completion-state-test.mjs",
    "test:atlas": "node scripts/atlas-state-test.mjs",
    "test:guide-notes": "node scripts/guide-notes-state-test.mjs",
    "test:catalogue": "node scripts/collectible-state-test.mjs",
    "test:build-lab": "node scripts/build-lab-state-test.mjs",
    "test:all": "npm run test:completion && npm run test:atlas && npm run test:guide-notes && npm run test:catalogue && npm run test:build-lab",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "health:content": "node scripts/content-health.mjs",
    "export:steam": "node scripts/export-steam.mjs",
    "check:all": "npm run generate:all && npm run audit:all && npm run test:all && npm run build && npm run smoke:deployment && npm run export:steam",
    "check:subpath": "node scripts/check-subpath-build.mjs",
    "check:ci": "npm run check:all && npm run check:subpath"
  },
  "dependencies": {
    "@astrojs/starlight": "0.39.2",
    "astro": "6.3.8",
    "sharp": "0.34.5"
  }
}
