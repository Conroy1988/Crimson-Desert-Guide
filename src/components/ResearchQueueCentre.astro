argin:.7rem 0 0;padding-left:1.15rem}.research-card__protocol li{margin-block:.35rem;font-size:.78rem;color:var(--sl-color-gray-2)}.research-card__protocol h4{margin-top:1rem!important}.research-card__local>div{display:grid;grid-template-columns:minmax(9rem,.55fr) minmax(0,1.45fr);gap:.7rem}.research-card__local label{display:grid;gap:.3rem;min-width:0}.research-card__local textarea{resize:vertical}.research-card__local small{display:block;margin-top:.5rem;color:var(--sl-color-gray-4)}.research-card footer{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:space-between;padding-top:.7rem;border-top:1px solid var(--cd-border)}.research-card footer div{display:flex;flex-wrap:wrap;gap:.55rem}.research-card footer a{font-size:.7rem;font-weight:750}.research-queue__empty{padding:2rem;border:1px dashed var(--cd-border);border-radius:.7rem;text-align:center}.research-queue__empty[hidden]{display:none}:global(:root[data-theme='light']) .research-queue__hero{background:radial-gradient(circle at 90% 0,rgb(167 44 25/10%),transparent 34%),linear-gradient(135deg,#fffdf9,#f3e7d8)}:global(:root[data-theme='light']) .research-queue__hero h2{color:#2f1c0d!important}:global(:root[data-theme='light']) .research-queue__hero p{color:#4d3e32!important}:global(:root[data-theme='light']) .research-queue__hero dl div,:global(:root[data-theme='light']) .research-card__facts,:global(:root[data-theme='light']) .research-card__gaps,:global(:root[data-theme='light']) .research-card__blockers,:global(:root[data-theme='light']) .research-card__protocol,:global(:root[data-theme='light']) .research-card__local{background:#fffaf3}:global(:root[data-theme='light']) .research-queue__filters :is(input,select),:global(:root[data-theme='light']) .research-card__local :is(select,textarea),:global(:root[data-theme='light']) .research-queue__actions button{background:#fffdf9;color:#2c211a}@media (max-width: 72rem){.research-queue__filters{grid-template-columns:repeat(3,minmax(0,1fr))}.research-queue__grid{grid-template-columns:1fr}}@media (max-width: 48rem){.research-queue__hero{grid-template-columns:1fr;gap:1rem}.research-queue__hero dl{grid-template-columns:repeat(4,minmax(0,1fr))}.research-queue__hero dl div{min-height:4rem;padding:.45rem}.research-queue__hero dd{font-size:1.2rem}.research-queue__filters{grid-template-columns:1fr 1fr}.research-queue__filters label:first-child{grid-column:1/-1}.research-queue__actions{align-items:stretch}.research-queue__actions>div:last-child{display:grid;grid-template-columns:1fr 1fr;width:100%}.research-card__facts dl,.research-card__local>div{grid-template-columns:1fr}.research-card footer{display:grid}}@media (max-width: 24rem){.research-queue__hero dl,.research-queue__filters,.research-queue__actions>div:last-child{grid-template-columns:1fr 1fr}.research-queue__hero dl div{min-height:3.6rem}.research-card{padding:.8rem}}
</style>
