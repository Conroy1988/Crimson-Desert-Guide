---
import queue from '../../data/research-queue.json';

const types = [...new Map(queue.records.map((record) => [record.type, record.typeLabel])).entries()]
  .map(([id, label]) => ({ id, label }))
  .sort((a, b) => a.label.localeCompare(b.label));
const highPriority = queue.records.filter((record) => record.priority === 'high').length;
const mediumPriority = queue.records.filter((record) => record.priority === 'medium').length;
---

<section class="research-queue" data-research-queue aria-labelledby="research-queue-title">
  <header class="research-queue__hero">
    <div>
      <p class="research-queue__kicker">Evidence operations · Patch {queue.gamePatch}</p>
      <h2 id="research-queue-title">Research Queue Centre</h2>
      <p>
        Every card is a real, sourced Crimson Desert record with one or more facts still missing.
        Use the protocol to collect reproducible evidence without turning assumptions into guide claims.
      </p>
    </div>
    <dl>
      <div><dt>Open records</dt><dd>{queue.records.length}</dd></div>
      <div><dt>High value</dt><dd>{highPriority}</dd></div>
      <div><dt>Medium value</dt><dd>{mediumPriority}</dd></div>
      <div><dt>Saved locally</dt><dd data-research-saved>0</dd></div>
    </dl>
  </header>

  <aside class="research-queue__boundary">
    <strong>Evidence boundary</strong>
    <span>
      A local status or note is private planning data. It does not verify a route, reward, mechanic or statistic and is never promoted automatically into the canonical guide.
    </span>
  </aside>

  <div class="research-queue__workspace">
    <div class="research-queue__filters" aria-label="Research queue filters">
      <label>
        <span>Search</span>
        <input type="search" placeholder="Quest, boss, gap, region or blocker" data-research-search />
      </label>
      <label>
        <span>Type</span>
        <select data-research-type>
          <option value="all">All types</option>
          {types.map((type) => <option value={type.id}>{type.label}</option>)}
        </select>
      </label>
      <label>
        <span>Priority</span>
        <select data-research-priority>
          <option value="all">All priorities</option>
          {queue.priorities.map((priority) => <option value={priority.id}>{priority.label}</option>)}
        </select>
      </label>
      <label>
        <span>Evidence gap</span>
        <select data-research-gap>
          <option value="all">All gaps</option>
          {queue.gapDefinitions.map((gap) => <option value={gap.id}>{gap.label}</option>)}
        </select>
      </label>
      <label>
        <span>My stage</span>
        <select data-research-stage>
          <option value="all">All stages</option>
          <option value="untracked">Not tracked</option>
          <option value="planned">Planned</option>
          <option value="testing">Testing</option>
          <option value="evidence-ready">Evidence ready</option>
        </select>
      </label>
      <label>
        <span>Spoilers</span>
        <select data-research-spoiler>
          <option value="all">All, masked</option>
          <option value="safe">No spoilers</option>
          <option value="minor">Up to minor</option>
        </select>
      </label>
    </div>

    <div class="research-queue__actions">
      <div aria-live="polite">
        <strong data-research-count>{queue.records.length}</strong> records shown
        <span data-research-stage-counts>0 planned · 0 testing · 0 evidence ready</span>
      </div>
      <div>
        <button type="button" data-research-reset-filters>Reset filters</button>
        <button type="button" data-research-export>Export my work</button>
        <button type="button" data-research-import>Import my work</button>
        <button type="button" class="danger" data-research-reset>Reset local work</button>
        <input type="file" accept="application/json,.json" hidden data-research-file />
      </div>
    </div>
    <p class="research-queue__status" data-research-status aria-live="polite"></p>
  </div>

  <div class="research-queue__grid">
    {queue.records.map((record) => {
      const masked = record.spoilerLevel === 'full';
      return (
        <article
          class={`research-card research-card--${record.priority}`}
          data-research-card
          data-record-id={record.id}
          data-type={record.type}
          data-priority={record.priority}
          data-gaps={record.gapIds.join(' ')}
          data-spoiler={record.spoilerLevel}
          data-search={record.searchText}
          data-stage="untracked"
        >
          <header class="research-card__header">
            <div>
              <span>{record.typeLabel}</span>
              <span>{record.regionLabel}</span>
              <span class={`research-card__priority research-card__priority--${record.priority}`}>
                {queue.priorities.find((priority) => priority.id === record.priority)?.label ?? record.priority}
              </span>
            </div>
            <span>Patch {record.firstSupportedPatch}+</span>
          </header>

          <div class="research-card__title">
            <h3 data-research-title>{masked ? 'Spoiler-hidden research record' : record.title}</h3>
            {masked && (
              <button type="button" data-research-reveal data-title={record.title} aria-expanded="false">
                Reveal identity
              </button>
            )}
          </div>
          <p>{record.summary}</p>

          <section class="research-card__facts" aria-label="Confirmed facts">
            <h4>Already confirmed</h4>
            <dl>
              {record.confirmedFacts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
            </dl>
          </section>

          <section class="research-card__gaps" aria-label="Missing evidence">
            <h4>Evidence still needed</h4>
            <ul>
              {record.gaps.map((gap) => <li title={gap.description}>{gap.label}</li>)}
            </ul>
          </section>

          {record.knownBlockers.length > 0 && (
            <aside class="research-card__blockers">
              <strong>Historical blocker context</strong>
              <ul>{record.knownBlockers.map((blocker) => <li>{blocker}</li>)}</ul>
            </aside>
          )}

          <details class="research-card__protocol">
            <summary>Open controlled test protocol</summary>
            <ol>{record.protocol.map((step) => <li>{step}</li>)}</ol>
            <h4>Minimum evidence package</h4>
            <ul>{record.evidenceChecklist.map((item) => <li>{item}</li>)}</ul>
          </details>

          <section class="research-card__local" aria-label="Private local research state">
            <div>
              <label>
                <span>My stage</span>
                <select data-record-stage>
                  <option value="">Not tracked</option>
                  <option value="planned">Planned</option>
                  <option value="testing">Testing</option>
                  <option value="evidence-ready">Evidence ready</option>
                </select>
              </label>
              <label class="research-card__note">
                <span>Private note</span>
                <textarea rows="3" maxlength="5000" placeholder="Save route hypotheses, test conditions or evidence still to capture" data-record-note></textarea>
              </label>
            </div>
            <small>Stored only in this browser. Export a backup before clearing site data.</small>
          </section>

          <footer>
            <a href={record.guidePath}>Open related guide</a>
            <div>{record.sources.map((source, index) => <a href={source} target="_blank" rel="noreferrer">Official source {index + 1}</a>)}</div>
          </footer>
        </article>
      );
    })}
  </div>
  <p class="research-queue__empty" data-research-empty hidden>No research records match the current filters.</p>
</section>

<script id="research-queue-data" type="application/json" set:html={JSON.stringify(queue)}></script>

<script>
  import {
    createEmptyResearchQueueState,
    createResearchQueueExport,
    loadResearchQueueState,
    parseResearchQueueImport,
    saveResearchQueueState,
    setResearchNote,
    setResearchStage,
  } from '../lib/research-queue-state.mjs';

  const bindResearchQueue = () => {
    const root = document.querySelector('[data-research-queue]');
    const dataNode = document.querySelector('#research-queue-data');
    if (!(root instanceof HTMLElement) || !(dataNode instanceof HTMLScriptElement) || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const dataset = JSON.parse(dataNode.textContent || '{}');
    const search = root.querySelector('[data-research-search]');
    const type = root.querySelector('[data-research-type]');
    const priority = root.querySelector('[data-research-priority]');
    const gap = root.querySelector('[data-research-gap]');
    const stageFilter = root.querySelector('[data-research-stage]');
    const spoiler = root.querySelector('[data-research-spoiler]');
    const count = root.querySelector('[data-research-count]');
    const saved = root.querySelector('[data-research-saved]');
    const stageCounts = root.querySelector('[data-research-stage-counts]');
    const status = root.querySelector('[data-research-status]');
    const empty = root.querySelector('[data-research-empty]');
    const fileInput = root.querySelector('[data-research-file]');
    const cards = [...root.querySelectorAll('[data-research-card]')];
    let state = createEmptyResearchQueueState(dataset);

    const report = (message, error = false) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.toggleAttribute('data-error', error);
    };

    try {
      const loaded = loadResearchQueueState(window.localStorage, dataset);
      state = loaded.state;
      if (loaded.error) report(loaded.error, true);
    } catch (error) {
      report(error instanceof Error ? error.message : 'Research state could not be loaded.', true);
    }

    const selected = (control) => control instanceof HTMLSelectElement ? control.value : 'all';
    const stageFor = (id) => state.stages[id] ?? 'untracked';

    const saveState = () => {
      try {
        state = saveResearchQueueState(window.localStorage, state, dataset).state;
        report('Private research state saved in this browser.');
      } catch (error) {
        report(error instanceof Error ? error.message : 'Research state could not be saved.', true);
      }
    };

    const filter = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const spoilerLevel = card.dataset.spoiler ?? 'none';
        const spoilerPass = selected(spoiler) === 'all' ||
          (selected(spoiler) === 'safe' && spoilerLevel === 'none') ||
          (selected(spoiler) === 'minor' && spoilerLevel !== 'full');
        const stage = card.dataset.stage ?? 'untracked';
        const show = (!query || (card.dataset.search ?? '').includes(query)) &&
          (selected(type) === 'all' || card.dataset.type === selected(type)) &&
          (selected(priority) === 'all' || card.dataset.priority === selected(priority)) &&
          (selected(gap) === 'all' || (card.dataset.gaps ?? '').split(' ').includes(selected(gap))) &&
          (selected(stageFilter) === 'all' || stage === selected(stageFilter)) && spoilerPass;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    };

    const renderState = () => {
      const totals = { planned: 0, testing: 0, 'evidence-ready': 0 };
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const id = card.dataset.recordId ?? '';
        const stage = stageFor(id);
        card.dataset.stage = stage;
        const select = card.querySelector('[data-record-stage]');
        const note = card.querySelector('[data-record-note]');
        if (select instanceof HTMLSelectElement) select.value = stage === 'untracked' ? '' : stage;
        if (note instanceof HTMLTextAreaElement) note.value = state.notes[id] ?? '';
        if (stage !== 'untracked') totals[stage] += 1;
      }
      const savedCount = Object.keys(state.stages).length + Object.keys(state.notes).filter((id) => !state.stages[id]).length;
      if (saved) saved.textContent = String(savedCount);
      if (stageCounts) stageCounts.textContent = `${totals.planned} planned · ${totals.testing} testing · ${totals['evidence-ready']} evidence ready`;
      filter();
    };

    for (const control of [search, type, priority, gap, stageFilter, spoiler]) {
      control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', filter);
    }

    root.querySelector('[data-research-reset-filters]')?.addEventListener('click', () => {
      if (search instanceof HTMLInputElement) search.value = '';
      for (const control of [type, priority, gap, stageFilter, spoiler]) if (control instanceof HTMLSelectElement) control.value = 'all';
      filter();
      search?.focus();
    });

    for (const card of cards) {
      if (!(card instanceof HTMLElement)) continue;
      const id = card.dataset.recordId ?? '';
      const stageSelect = card.querySelector('[data-record-stage]');
      const note = card.querySelector('[data-record-note]');
      stageSelect?.addEventListener('change', () => {
        if (!(stageSelect instanceof HTMLSelectElement)) return;
        try {
          state = setResearchStage(state, dataset, id, stageSelect.value);
          saveState();
          renderState();
        } catch (error) {
          report(error instanceof Error ? error.message : 'Research stage could not be saved.', true);
        }
      });
      note?.addEventListener('change', () => {
        if (!(note instanceof HTMLTextAreaElement)) return;
        try {
          state = setResearchNote(state, dataset, id, note.value);
          saveState();
          renderState();
        } catch (error) {
          report(error instanceof Error ? error.message : 'Research note could not be saved.', true);
        }
      });
    }

    for (const button of root.querySelectorAll('[data-research-reveal]')) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const title = button.closest('[data-research-card]')?.querySelector('[data-research-title]');
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? 'Reveal identity' : 'Hide identity';
        if (title) title.textContent = expanded ? 'Spoiler-hidden research record' : button.dataset.title ?? 'Spoiler-hidden research record';
      });
    }

    root.querySelector('[data-research-export]')?.addEventListener('click', () => {
      try {
        const payload = createResearchQueueExport(state, dataset);
        const blob = new Blob([`${JSON.stringify(payload, null, 2)}\n`], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `crimson-desert-research-${new Date().toISOString().slice(0, 10)}.json`;
        link.click();
        URL.revokeObjectURL(url);
        report('Research queue backup exported.');
      } catch (error) {
        report(error instanceof Error ? error.message : 'Research queue could not be exported.', true);
      }
    });

    root.querySelector('[data-research-import]')?.addEventListener('click', () => {
      if (fileInput instanceof HTMLInputElement) fileInput.click();
    });
    fileInput?.addEventListener('change', async () => {
      if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) return;
      try {
        const imported = parseResearchQueueImport(JSON.parse(await fileInput.files[0].text()), dataset);
        state = saveResearchQueueState(window.localStorage, imported, dataset).state;
        renderState();
        report('Research queue backup imported.');
      } catch (error) {
        report(error instanceof Error ? error.message : 'Research queue backup could not be imported.', true);
      } finally {
        fileInput.value = '';
      }
    });

    root.querySelector('[data-research-reset]')?.addEventListener('click', () => {
      if (!window.confirm('Reset all private research stages and notes stored in this browser?')) return;
      window.localStorage.removeItem(dataset.storageKey);
      state = createEmptyResearchQueueState(dataset);
      renderState();
      report('Private research state reset.');
    });

    renderState();
  };

  bindResearchQueue();
  document.addEventListener('astro:page-load', bindResearchQueue);
</script>

