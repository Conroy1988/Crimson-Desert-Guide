---
import dataset from '../../data/content-database.json';

const typeById = new Map(dataset.types.map((item) => [item.id, item.label]));
const regionById = new Map(dataset.regions.map((item) => [item.id, item.label]));
const verified = dataset.records.filter((record) => record.recordStatus === 'verified').length;
const eligible = dataset.records.filter((record) => record.completion.eligible).length;
const bosses = dataset.records.filter((record) => record.type === 'boss').length;
---

<section class="content-db" data-content-db>
  <header class="content-db__hero">
    <div>
      <p class="content-db__eyebrow">Canonical Pywel records</p>
      <h2>Quest, boss and world-content archive</h2>
      <p>Official achievements and Pearl Abyss notices, separated into completion-safe records and evidence gaps.</p>
    </div>
    <dl>
      <div><dt>Records</dt><dd>{dataset.records.length}</dd></div>
      <div><dt>Verified</dt><dd>{verified}</dd></div>
      <div><dt>Trackable</dt><dd>{eligible}</dd></div>
      <div><dt>Bosses</dt><dd>{bosses}</dd></div>
      <div><dt>Patch</dt><dd>{dataset.gamePatch}</dd></div>
    </dl>
  </header>

  <aside class="content-db__notice">
    <strong>Evidence boundary</strong>
    <span>Partial records remain searchable but never enter completion percentages. Exact rewards and routes are omitted unless sourced.</span>
    <a href="/completion/">Open Completion Companion →</a>
  </aside>

  <div class="content-db__filters" aria-label="Content database filters">
    <label><span>Search</span><input type="search" placeholder="Quest, boss, challenge, region or blocker" data-db-search /></label>
    <label><span>Type</span><select data-db-type><option value="all">All types</option>{dataset.types.map((item) => <option value={item.id}>{item.label}</option>)}</select></label>
    <label><span>Region</span><select data-db-region><option value="all">All regions</option>{dataset.regions.map((item) => <option value={item.id}>{item.label}</option>)}</select></label>
    <label><span>Status</span><select data-db-status><option value="all">All records</option><option value="verified">Verified</option><option value="partial">Research records</option></select></label>
    <label><span>Completion</span><select data-db-completion><option value="all">All records</option><option value="eligible">Trackable</option><option value="research">Excluded from totals</option></select></label>
    <label><span>Spoilers</span><select data-db-spoiler><option value="all">All, masked</option><option value="safe">No spoilers</option><option value="minor">Up to minor</option></select></label>
  </div>

  <div class="content-db__result" aria-live="polite">
    <span><strong data-db-count>{dataset.records.length}</strong> records shown</span>
    <button type="button" data-db-reset>Reset filters</button>
  </div>

  <div class="content-db__grid">
    {dataset.records.map((record) => {
      const typeLabel = typeById.get(record.type) ?? record.type;
      const regionLabel = regionById.get(record.region) ?? record.region;
      const masked = record.spoilerLevel === 'full';
      const searchText = [record.title, record.summary, typeLabel, regionLabel, ...record.tags, ...record.knownBlockers, record.completion.condition ?? ''].join(' ').toLowerCase();
      return (
        <article
          class={`db-card db-card--${record.recordStatus}`}
          data-db-card
          data-type={record.type}
          data-region={record.region}
          data-status={record.recordStatus}
          data-completion={record.completion.eligible ? 'eligible' : 'research'}
          data-spoiler={record.spoilerLevel}
          data-search={searchText}
        >
          <header>
            <span>{typeLabel}</span><span>{regionLabel}</span>
            <span class={`db-card__state db-card__state--${record.recordStatus}`}>{record.recordStatus === 'verified' ? 'Verified' : 'Research'}</span>
          </header>
          <h3 data-db-title>{masked ? 'Spoiler-hidden record' : record.title}</h3>
          {masked && <button type="button" class="db-card__reveal" data-db-reveal data-title={record.title} aria-expanded="false">Reveal identity</button>}
          <p>{record.summary}</p>
          <dl class="db-card__facts">
            <div><dt>Role</dt><dd>{record.storyRole}</dd></div>
            <div><dt>Replay</dt><dd>{record.replayability}</dd></div>
            <div><dt>Evidence</dt><dd>{record.evidence}</dd></div>
            <div><dt>First patch</dt><dd>{record.firstSupportedPatch}</dd></div>
          </dl>
          <div class={`db-card__completion ${record.completion.eligible ? 'is-eligible' : ''}`}>
            <strong>{record.completion.eligible ? 'Completion milestone' : 'Excluded from percentage'}</strong>
            <span>{record.completion.eligible ? record.completion.condition : 'Route or completion condition still requires verification.'}</span>
          </div>
          {record.knownBlockers.length > 0 && <div class="db-card__blockers"><strong>Blocker history</strong><ul>{record.knownBlockers.map((item) => <li>{item}</li>)}</ul></div>}
          <footer>
            <a href={record.guidePath}>Related guide</a>
            <div>{record.sources.map((source, index) => <a href={source} target="_blank" rel="noreferrer">Source {index + 1}</a>)}</div>
          </footer>
        </article>
      );
    })}
  </div>
  <p class="content-db__empty" data-db-empty hidden>No records match the current filters.</p>
</section>

<script>
  const bindDatabase = () => {
    const root = document.querySelector('[data-content-db]');
    if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const search = root.querySelector('[data-db-search]');
    const type = root.querySelector('[data-db-type]');
    const region = root.querySelector('[data-db-region]');
    const status = root.querySelector('[data-db-status]');
    const completion = root.querySelector('[data-db-completion]');
    const spoiler = root.querySelector('[data-db-spoiler]');
    const count = root.querySelector('[data-db-count]');
    const empty = root.querySelector('[data-db-empty]');
    const cards = [...root.querySelectorAll('[data-db-card]')];

    const selected = (control) => control instanceof HTMLSelectElement ? control.value : 'all';
    const filter = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const spoilerLevel = card.dataset.spoiler ?? 'none';
        const spoilerPass = selected(spoiler) === 'all' || (selected(spoiler) === 'safe' && spoilerLevel === 'none') || (selected(spoiler) === 'minor' && spoilerLevel !== 'full');
        const show = (!query || (card.dataset.search ?? '').includes(query)) &&
          (selected(type) === 'all' || card.dataset.type === selected(type)) &&
          (selected(region) === 'all' || card.dataset.region === selected(region)) &&
          (selected(status) === 'all' || card.dataset.status === selected(status)) &&
          (selected(completion) === 'all' || card.dataset.completion === selected(completion)) && spoilerPass;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    };

    for (const control of [search, type, region, status, completion, spoiler]) control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', filter);
    root.querySelector('[data-db-reset]')?.addEventListener('click', () => {
      if (search instanceof HTMLInputElement) search.value = '';
      for (const control of [type, region, status, completion, spoiler]) if (control instanceof HTMLSelectElement) control.value = 'all';
      filter();
      if (search instanceof HTMLInputElement) search.focus();
    });
    for (const button of root.querySelectorAll('[data-db-reveal]')) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const title = button.closest('[data-db-card]')?.querySelector('[data-db-title]');
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? 'Reveal identity' : 'Hide identity';
        if (title) title.textContent = expanded ? 'Spoiler-hidden record' : button.dataset.title ?? 'Spoiler-hidden record';
      });
    }
    filter();
  };
  bindDatabase();
  document.addEventListener('astro:page-load', bindDatabase);
</script>

<style>
  .content-db{display:grid;gap:1rem;margin-block:1.5rem 3rem}.content-db__hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr);gap:2rem;padding:clamp(1.2rem,4vw,2.2rem);border:1px solid rgb(213 163 80/30%);border-radius:.9rem;background:radial-gradient(circle at 92% 0,rgb(167 44 25/24%),transparent 33%),linear-gradient(135deg,rgb(18 15 12/97%),rgb(8 8 7/98%));box-shadow:0 1.5rem 4rem rgb(0 0 0/24%)}.content-db__eyebrow{margin:0 0 .5rem!important;font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#d6a85f!important}.content-db__hero h2{margin:0!important;border:0!important;font-size:clamp(1.8rem,4vw,3rem)!important;color:#f4dfb5!important}.content-db__hero p{color:#c8b99f!important}.content-db__hero dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin:0}.content-db__hero dl div{display:grid;place-content:center;min-height:4.7rem;padding:.65rem;border:1px solid rgb(213 163 80/20%);border-radius:.5rem;background:rgb(0 0 0/24%);text-align:center}.content-db__hero dt{font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:#9f917b}.content-db__hero dd{margin:0;font-family:var(--cd-font-display);font-size:1.3rem;color:#efc979}.content-db__notice,.content-db__filters,.content-db__result{border:1px solid var(--cd-border);border-radius:.7rem;background:var(--cd-surface)}.content-db__notice{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;padding:.85rem 1rem}.content-db__notice span{flex:1;min-width:16rem;color:var(--sl-color-gray-2)}.content-db__filters{display:grid;grid-template-columns:minmax(15rem,2fr) repeat(5,minmax(8rem,1fr));gap:.7rem;padding:1rem}.content-db__filters label{display:grid;gap:.3rem}.content-db__filters label>span{font-size:.6rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--sl-color-gray-3)}.content-db__filters :is(input,select){width:100%;min-height:2.55rem;padding:.5rem .65rem;border:1px solid var(--cd-border);border-radius:.45rem;background:color-mix(in srgb,var(--sl-color-black) 82%,transparent);color:var(--sl-color-gray-1)}.content-db__result{display:flex;justify-content:space-between;padding:.6rem .8rem;font-size:.78rem;color:var(--sl-color-gray-3)}.content-db__result button{border:0;background:transparent;font-weight:750;color:var(--sl-color-accent-high);cursor:pointer}.content-db__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.db-card{display:grid;gap:.75rem;padding:1rem;border:1px solid rgb(210 160 78/22%);border-radius:.75rem;background:linear-gradient(145deg,rgb(255 255 255/2.5%),transparent 55%),var(--cd-surface);box-shadow:0 .9rem 2.2rem rgb(0 0 0/10%)}.db-card[hidden]{display:none}.db-card--partial{border-style:dashed}.db-card header{display:flex;flex-wrap:wrap;gap:.35rem}.db-card header span{padding:.22rem .4rem;border:1px solid var(--cd-border);border-radius:999px;font-size:.56rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--sl-color-gray-3)}.db-card__state--verified{color:#8fc59b!important}.db-card__state--partial{color:#d7a85f!important}.db-card h3{margin:0!important;font-size:clamp(1.25rem,2vw,1.7rem)!important}.db-card p{margin:0!important}.db-card__reveal{width:fit-content;padding:.38rem .62rem;border:1px solid rgb(209 155 70/36%);border-radius:.4rem;background:rgb(154 43 24/18%);font-size:.66rem;font-weight:800;color:#edc478;cursor:pointer}.db-card__facts{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;margin:0}.db-card__facts div,.db-card__completion,.db-card__blockers{padding:.55rem;border:1px solid var(--cd-border);border-radius:.45rem;background:rgb(0 0 0/10%)}.db-card__facts dt,.db-card__completion strong,.db-card__blockers strong{font-size:.54rem;letter-spacing:.08em;text-transform:uppercase;color:var(--sl-color-gray-4)}.db-card__facts dd{margin:.15rem 0 0;font-size:.68rem}.db-card__completion{display:grid;gap:.2rem}.db-card__completion span{font-size:.77rem;color:var(--sl-color-gray-2)}.db-card__completion.is-eligible{border-color:rgb(80 151 99/35%);background:rgb(43 112 62/10%)}.db-card__completion.is-eligible strong{color:#8fc59b}.db-card__blockers ul{margin:.35rem 0 0;padding-left:1rem}.db-card footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;padding-top:.65rem;border-top:1px solid var(--cd-border)}.db-card footer div{display:flex;flex-wrap:wrap;gap:.5rem}.db-card footer a{font-size:.7rem;font-weight:750}.content-db__empty{padding:2rem;border:1px dashed var(--cd-border);border-radius:.7rem;text-align:center}:root[data-theme='light'] .content-db__hero{background:radial-gradient(circle at 92% 0,rgb(167 44 25/12%),transparent 33%),linear-gradient(135deg,#fffdf9,#efe2d2)}:root[data-theme='light'] .content-db__hero h2{color:#3f1d13!important}:root[data-theme='light'] .content-db__hero p{color:#59483a!important}:root[data-theme='light'] .content-db__hero dl div{background:rgb(255 253 249/72%)}:root[data-theme='light'] .content-db__filters :is(input,select){background:#fffdf9;color:#2c211a}@media(max-width:78rem){.content-db__filters{grid-template-columns:repeat(3,minmax(0,1fr))}.content-db__filters label:first-child{grid-column:span 3}}@media(max-width:58rem){.content-db__hero,.content-db__grid{grid-template-columns:1fr}}@media(max-width:38rem){.content-db__filters{grid-template-columns:1fr}.content-db__filters label:first-child{grid-column:auto}.content-db__hero dl{grid-template-columns:repeat(2,1fr)}.db-card__facts{grid-template-columns:repeat(2,1fr)}.db-card footer{display:grid}}
</style>
