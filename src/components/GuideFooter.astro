---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

<DefaultFooter><slot /></DefaultFooter>

<footer class="guide-footer-note" aria-label="Crimson Desert Guide project information">
  <div class="guide-footer-note__brand">
    <img src="/favicon.svg" alt="" width="50" height="50" />
    <div>
      <strong>Crimson Desert Guide</strong>
      <span>Independent · Evidence-led · Patch-aware</span>
    </div>
  </div>

  <nav aria-label="Guide footer navigation">
    <a href="/start-here/beginner-roadmap/">Beginner</a>
    <a href="/systems/combat/">Combat</a>
    <a href="/world/">World</a>
    <a href="/completion/">Completion</a>
    <a href="/technical/">Technical</a>
  </nav>

  <p>
    This is unofficial content which contains copyrighted materials and IP from Pearl Abyss,
    and is not official or endorsed content.
  </p>
</footer>

<style>
  .guide-footer-note {
    position: relative;
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto minmax(18rem, 1fr);
    gap: 1.5rem;
    align-items: center;
    overflow: hidden;
    margin-top: 2rem;
    padding: 1.15rem;
    border: 1px solid rgb(201 147 62 / 24%);
    border-radius: 0.75rem;
    background:
      radial-gradient(circle at 0 100%, rgb(157 45 32 / 14%), transparent 32%),
      linear-gradient(135deg, rgb(255 255 255 / 2.5%), transparent 48%),
      rgb(12 12 11 / 92%);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 22%);
  }

  .guide-footer-note::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    content: '';
    background: linear-gradient(#d45535, #c9933e, transparent);
  }

  .guide-footer-note__brand {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .guide-footer-note__brand img {
    width: 2.65rem;
    height: 2.65rem;
    filter: sepia(0.25) saturate(1.2) drop-shadow(0 0.4rem 0.8rem rgb(201 147 62 / 22%));
  }

  .guide-footer-note__brand div {
    display: grid;
    gap: 0.2rem;
  }

  .guide-footer-note strong {
    font-family: var(--cd-font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.035em;
    color: #f1cc83;
  }

  .guide-footer-note span,
  .guide-footer-note p,
  .guide-footer-note a {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .guide-footer-note span,
  .guide-footer-note p {
    color: var(--sl-color-gray-3);
  }

  .guide-footer-note nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    justify-content: center;
  }

  .guide-footer-note a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .guide-footer-note a:hover {
    color: #f1cc83;
  }

  .guide-footer-note p {
    max-width: 31rem;
    text-align: right;
  }

  :global(:root[data-theme='light']) .guide-footer-note {
    border-color: #c9b79f;
    background:
      radial-gradient(circle at 0 100%, rgb(157 45 32 / 8%), transparent 32%),
      linear-gradient(135deg, rgb(255 255 255 / 82%), transparent 48%),
      #fffdf9;
    box-shadow: 0 0.8rem 2rem rgb(91 55 32 / 9%);
  }

  :global(:root[data-theme='light']) .guide-footer-note strong,
  :global(:root[data-theme='light']) .guide-footer-note a:hover {
    color: #633d0b;
  }

  :global(:root[data-theme='light']) .guide-footer-note a,
  :global(:root[data-theme='light']) .guide-footer-note span,
  :global(:root[data-theme='light']) .guide-footer-note p {
    color: #5f4e40;
  }

  @media (max-width: 64rem) {
    .guide-footer-note {
      grid-template-columns: 1fr 1fr;
    }

    .guide-footer-note nav {
      justify-content: flex-end;
    }

    .guide-footer-note p {
      grid-column: 1 / -1;
      max-width: none;
      text-align: left;
    }
  }

  @media (max-width: 40rem) {
    .guide-footer-note {
      grid-template-columns: 1fr;
    }

    .guide-footer-note nav {
      justify-content: flex-start;
    }

    .guide-footer-note p {
      grid-column: auto;
    }
  }
</style>