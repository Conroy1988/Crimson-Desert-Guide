---
import dataset from '../../data/command-centre.json';

const assetById = new Map(dataset.media.assets.map((asset) => [asset.id, asset]));
const hero = assetById.get('official-kliff-launch') ?? dataset.media.assets[0];
const categoryAssets = [
  assetById.get('official-boss-forest-colossus'),
  assetById.get('official-weapon-pickaxe'),
  assetById.get('official-pywel-horse'),
  assetById.get('official-settlement-lakeside'),
].filter(Boolean);
---

<section class="expedition-command" data-expedition-command style={`--command-hero: url('${hero.src}')`}>
  <script id="expedition-command-data" type="application/json" set:html={JSON.stringify(dataset)}></script>

  <header class="command-hero">
    <div class="command-hero__shade" aria-hidden="true"></div>
    <div class="command-hero__content">
      <p class="command-kicker">Personal operations layer · Patch {dataset.gamePatch}</p>
      <h2>Pywel Expedition Command Centre</h2>
      <p>Plan the next session, resume recent guidance, search the full evidence archive and back up every supported local guide state from one control room.</p>
      <div class="command-hero__actions">
        <a href="#expedition-planner">Build expedition</a>
        <a href="#command-search">Search command index</a>
      </div>
    </div>
    <dl class="command-hero__metrics">
      <div><dt>Search records</dt><dd>{dataset.metrics.searchableRecords}</dd></div>
      <div><dt>Planner targets</dt><dd>{dataset.metrics.plannerRecords}</dd></div>
      <div><dt>Official assets</dt><dd>{dataset.metrics.officialAssets}</dd></div>
      <div><dt>Guide patch</dt><dd>{dataset.gamePatch}</dd></div>
    </dl>
    <a class="command-hero__credit" href={hero.sourcePage} target="_blank" rel="noreferrer">Official artwork · Pearl Abyss</a>
  </header>

  <div class="command-resume" data-command-resume hidden>
    <div><span>Continue your adventure</span><strong data-resume-title></strong><small data-resume-time></small></div>
    <a data-resume-link>Resume guide →</a>
  </div>

  <section class="command-section" aria-labelledby="progress-overview-title">
    <header class="command-section__heading">
      <div><span>Unified local state</span><h3 id="progress-overview-title">Guide progress overview</h3></div>
      <p>These figures are read from this browser only. No account, telemetry or server-side profile is created.</p>
    </header>
    <div class="command-progress">
      {dataset.stateSources.map((source) => (
        <a class="progress-card" href={source.href} data-progress-source={source.id} data-progress-total={source.total}>
          <span>{source.label}</span>
          <strong><i data-progress-current>0</i><small data-progress-unit> / {source.total}</small></strong>
          <div aria-hidden="true"><i data-progress-bar></i></div>
          <small data-progress-detail>No local state yet</small>
        </a>
      ))}
    </div>
  </section>

  <div class="command-grid">
    <section class="command-panel command-panel--search" id="command-search" aria-labelledby="command-search-title">
      <header>
        <div><span>Command index</span><h3 id="command-search-title">Search the entire guide</h3></div>
        <kbd>/</kbd>
      </header>
      <div class="command-search-controls">
        <label><span>Search</span><input type="search" placeholder="Boss, weapon, mount, quest, location or guide…" data-command-search /></label>
        <label><span>Type</span><select data-command-type><option value="all">All records</option><option value="tool">Tools</option><option value="guide">Guides</option><option value="content">Quests & content</option><option value="location">Locations</option><option value="boss">Bosses</option><option value="weapon">Weapons</option><option value="build">Builds</option><option value="character">Characters</option></select></label>
      </div>
      <div class="command-search-summary"><span><strong data-command-count>0</strong> records shown</span><button type="button" data-command-clear>Clear</button></div>
      <div class="command-results" data-command-results></div>
      <p class="command-empty" data-command-empty hidden>No command records match the current filters.</p>
    </section>

    <aside class="command-panel command-profile" aria-labelledby="spoiler-profile-title">
      <header><div><span>Guide-wide preference</span><h3 id="spoiler-profile-title">Spoiler profile</h3></div></header>
      <p>Compatible databases, catalogues and Atlas filters inherit this browser-level preference on page load.</p>
      <label><span>Profile</span><select data-spoiler-profile>{dataset.spoilerProfiles.map((profile) => <option value={profile.id}>{profile.label}</option>)}</select></label>
      <div data-spoiler-description></div>
      <small>Manual reveal controls still remain available where the guide protects major identities.</small>
    </aside>
  </div>

  <section class="command-section command-planner" id="expedition-planner" aria-labelledby="expedition-planner-title">
    <header class="command-section__heading">
      <div><span>Private session preparation</span><h3 id="expedition-planner-title">Expedition planner</h3></div>
      <div class="planner-heading__actions"><strong><i data-planner-done>0</i>/<i data-planner-total>0</i> complete</strong><button type="button" data-planner-reset>Clear plan</button></div>
    </header>
    <div class="planner-add">
      <label><span>Add verified or research objective</span><select data-planner-select><option value="">Choose an objective</option>{dataset.plannerRecords.map((record) => <option value={record.id}>{record.typeLabel} · {record.title}</option>)}</select></label>
      <button type="button" data-planner-add>Add to expedition</button>
    </div>
    <div class="planner-list" data-planner-list></div>
    <p class="planner-empty" data-planner-empty>No objectives yet. Add a command-search result or choose an objective above.</p>
  </section>

  <div class="command-grid command-grid--vault">
    <section class="command-panel guide-vault" aria-labelledby="guide-vault-title">
      <header><div><span>Local-first resilience</span><h3 id="guide-vault-title">Complete guide data vault</h3></div><strong>Validated JSON</strong></header>
      <p>Back up the Expedition Planner, spoiler profile, Completion Companion, Atlas, Collectible Catalogue, Research Queue, Build Laboratory and last-viewed guide in one file.</p>
      <div class="guide-vault__actions">
        <button type="button" data-vault-export>Export complete vault</button>
        <button type="button" data-vault-import>Restore vault</button>
        <input type="file" accept="application/json,.json" hidden data-vault-file />
      </div>
      <p class="command-status" data-command-status aria-live="polite"></p>
    </section>

    <aside class="command-panel media-provenance" aria-labelledby="media-provenance-title">
      <header><div><span>Visual provenance</span><h3 id="media-provenance-title">Official asset registry</h3></div><strong>{dataset.media.assets.length}</strong></header>
      <p>Boss, weapon, mount, character and world visuals are restricted to official Pearl Abyss or official storefront media.</p>
      <div class="media-provenance__strip">
        {categoryAssets.map((asset) => <a href={asset.sourcePage} target="_blank" rel="noreferrer" title={asset.title}><img src={asset.src} alt={asset.alt} loading="lazy" /></a>)}
      </div>
      <nav><a href={dataset.media.mediaPage} target="_blank" rel="noreferrer">Official media library</a><a href={dataset.media.fanKit} target="_blank" rel="noreferrer">Official fan kit</a><a href={dataset.media.fanGuidelines} target="_blank" rel="noreferrer">Fan Content Guidelines</a></nav>
    </aside>
  </div>
</section>

<script>
  import {
    addExpeditionTask,
    createEmptyCommandCentreState,
    createGuideVault,
    loadCommandCentreState,
    moveExpeditionTask,
    removeExpeditionTask,
    restoreGuideVault,
    saveCommandCentreState,
    setSpoilerProfile,
    updateExpeditionTask,
  } from '../lib/command-centre-state.mjs';

  const bindExpeditionCommand = () => {
    for (const root of document.querySelectorAll('[data-expedition-command]')) {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') continue;
      root.dataset.bound = 'true';
      const dataNode = root.querySelector('#expedition-command-data');
      if (!(dataNode instanceof HTMLScriptElement)) continue;
      const dataset = JSON.parse(dataNode.textContent || '{}');
      const records = new Map(dataset.records.map((record) => [record.id, record]));
      const assets = new Map(dataset.media.assets.map((asset) => [asset.id, asset]));
      const status = root.querySelector('[data-command-status]');
      const search = root.querySelector('[data-command-search]');
      const type = root.querySelector('[data-command-type]');
      const results = root.querySelector('[data-command-results]');
      const count = root.querySelector('[data-command-count]');
      const empty = root.querySelector('[data-command-empty]');
      const profile = root.querySelector('[data-spoiler-profile]');
      const profileDescription = root.querySelector('[data-spoiler-description]');
      const plannerSelect = root.querySelector('[data-planner-select]');
      const plannerList = root.querySelector('[data-planner-list]');
      const plannerEmpty = root.querySelector('[data-planner-empty]');
      const plannerDone = root.querySelector('[data-planner-done]');
      const plannerTotal = root.querySelector('[data-planner-total]');
      const vaultFile = root.querySelector('[data-vault-file]');

      const announce = (message, failure = false) => {
        if (!(status instanceof HTMLElement)) return;
        status.textContent = message;
        status.toggleAttribute('data-failure', failure);
      };

      let state = createEmptyCommandCentreState(dataset);
      try {
        const loaded = loadCommandCentreState(window.localStorage, dataset);
        state = loaded.state;
        const storedProfile = window.localStorage.getItem(dataset.spoilerKey);
        if (dataset.spoilerProfiles.some((item) => item.id === storedProfile)) state.spoilerProfile = storedProfile;
        if (loaded.error) announce(loaded.error, true);
      } catch (error) {
        announce(error instanceof Error ? error.message : 'Command Centre state could not be loaded.', true);
      }

      const persist = () => {
        const saved = saveCommandCentreState(window.localStorage, state, dataset);
        state = saved.state;
      };

      const spoilerAllowed = (record) => {
        if (state.spoilerProfile === 'full') return true;
        if (state.spoilerProfile === 'minor') return record.spoilerLevel !== 'full';
        return record.spoilerLevel === 'none';
      };

      const displayTitle = (record) => spoilerAllowed(record) ? record.title : record.spoilerLevel === 'full' ? 'Major-spoiler objective' : 'Spoiler-controlled objective';

      const readStored = (key) => {
        try {
          const raw = window.localStorage.getItem(key);
          return raw ? JSON.parse(raw) : null;
        } catch { return null; }
      };

      const progressValue = (source, stored) => {
        if (!stored) return { current: 0, detail: 'No local state yet' };
        if (source.id === 'completion') return { current: Array.isArray(stored.completed) ? stored.completed.length : 0, detail: 'verified milestones completed' };
        if (source.id === 'atlas') return { current: Array.isArray(stored.visited) ? stored.visited.length : 0, detail: 'locations visited' };
        if (source.id === 'collectibles') {
          const ids = new Set([...Object.keys(stored.counts ?? {}), ...(Array.isArray(stored.research) ? stored.research : [])]);
          return { current: ids.size, detail: 'catalogue records tracked' };
        }
        if (source.id === 'research') return { current: Object.keys(stored.stages ?? {}).length, detail: 'research records staged' };
        if (source.id === 'builds') return { current: Array.isArray(stored.tests) ? stored.tests.length : 0, detail: 'controlled tests saved', noRatio: true };
        return { current: 0, detail: 'local state detected' };
      };

      const renderProgress = () => {
        for (const card of root.querySelectorAll('[data-progress-source]')) {
          if (!(card instanceof HTMLElement)) continue;
          const source = dataset.stateSources.find((item) => item.id === card.dataset.progressSource);
          if (!source) continue;
          const value = progressValue(source, readStored(source.storageKey));
          const current = card.querySelector('[data-progress-current]');
          const unit = card.querySelector('[data-progress-unit]');
          const detail = card.querySelector('[data-progress-detail]');
          const bar = card.querySelector('[data-progress-bar]');
          if (current) current.textContent = String(value.current);
          if (unit && value.noRatio) unit.textContent = '';
          if (detail) detail.textContent = value.detail;
          if (bar instanceof HTMLElement) bar.style.width = `${Math.min(100, Math.round((value.current / source.total) * 100))}%`;
        }
      };

      const renderResume = () => {
        const stored = readStored(dataset.lastRouteKey);
        const resume = root.querySelector('[data-command-resume]');
        if (!(resume instanceof HTMLElement) || !stored?.href || !stored?.title) return;
        const titleNode = resume.querySelector('[data-resume-title]');
        const timeNode = resume.querySelector('[data-resume-time]');
        const link = resume.querySelector('[data-resume-link]');
        if (titleNode) titleNode.textContent = stored.title;
        if (timeNode) timeNode.textContent = stored.visitedAt ? `Last opened ${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(stored.visitedAt))}` : 'Recently opened';
        if (link instanceof HTMLAnchorElement) link.href = stored.href;
        resume.hidden = false;
      };

      const makeResult = (record) => {
        const asset = assets.get(record.assetId);
        const article = document.createElement('article');
        article.className = 'command-result';
        article.dataset.spoiler = record.spoilerLevel;
        const image = document.createElement('img');
        image.src = asset?.src ?? '';
        image.alt = asset?.alt ?? '';
        image.loading = 'lazy';
        const copy = document.createElement('div');
        const meta = document.createElement('span');
        meta.textContent = `${record.typeLabel} · ${record.evidence}`;
        const heading = document.createElement('h4');
        heading.textContent = displayTitle(record);
        const paragraph = document.createElement('p');
        paragraph.textContent = spoilerAllowed(record) ? record.summary : 'This record is masked by the current guide-wide spoiler profile.';
        const actions = document.createElement('div');
        const open = document.createElement('a');
        open.href = record.href;
        open.textContent = 'Open';
        actions.append(open);
        if (record.plannerEligible) {
          const add = document.createElement('button');
          add.type = 'button';
          add.textContent = state.tasks.some((task) => task.recordId === record.id) ? 'Added' : 'Add to expedition';
          add.disabled = state.tasks.some((task) => task.recordId === record.id);
          add.addEventListener('click', () => {
            state = addExpeditionTask(state, dataset, record.id);
            persist();
            renderPlanner();
            renderSearch();
            announce(`${displayTitle(record)} added to the expedition.`);
          });
          actions.append(add);
        }
        copy.append(meta, heading, paragraph, actions);
        article.append(image, copy);
        return article;
      };

      const renderSearch = () => {
        if (!(results instanceof HTMLElement)) return;
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const selectedType = type instanceof HTMLSelectElement ? type.value : 'all';
        const matches = dataset.records.filter((record) => {
          const typePass = selectedType === 'all' || record.kind === selectedType || record.type === selectedType;
          const queryPass = !query || record.searchText.includes(query) || record.title.toLowerCase().includes(query);
          return typePass && queryPass;
        }).slice(0, 24);
        results.replaceChildren(...matches.map(makeResult));
        if (count) count.textContent = String(matches.length);
        if (empty instanceof HTMLElement) empty.hidden = matches.length !== 0;
      };

      const renderProfile = () => {
        if (profile instanceof HTMLSelectElement) profile.value = state.spoilerProfile;
        const selected = dataset.spoilerProfiles.find((item) => item.id === state.spoilerProfile);
        if (profileDescription instanceof HTMLElement) profileDescription.textContent = selected?.description ?? '';
        document.documentElement.dataset.spoilerProfile = state.spoilerProfile;
      };

      const renderPlanner = () => {
        if (!(plannerList instanceof HTMLElement)) return;
        const nodes = state.tasks.map((task, index) => {
          const record = records.get(task.recordId);
          const asset = assets.get(record.assetId);
          const article = document.createElement('article');
          article.className = 'planner-task';
          article.toggleAttribute('data-done', task.done);
          const image = document.createElement('img');
          image.src = asset?.src ?? '';
          image.alt = asset?.alt ?? '';
          image.loading = 'lazy';
          const body = document.createElement('div');
          const header = document.createElement('header');
          const check = document.createElement('input');
          check.type = 'checkbox';
          check.checked = task.done;
          check.setAttribute('aria-label', `Mark ${displayTitle(record)} complete`);
          check.addEventListener('change', () => { state = updateExpeditionTask(state, dataset, task.id, { done: check.checked }); persist(); renderPlanner(); });
          const title = document.createElement('div');
          const meta = document.createElement('span');
          meta.textContent = `${index + 1}. ${record.typeLabel}`;
          const heading = document.createElement('h4');
          heading.textContent = displayTitle(record);
          title.append(meta, heading);
          const controls = document.createElement('div');
          for (const [label, direction] of [['↑', 'up'], ['↓', 'down']]) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = label;
            button.title = direction === 'up' ? 'Move objective up' : 'Move objective down';
            button.disabled = direction === 'up' ? index === 0 : index === state.tasks.length - 1;
            button.addEventListener('click', () => { state = moveExpeditionTask(state, dataset, task.id, direction); persist(); renderPlanner(); });
            controls.append(button);
          }
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = 'Remove';
          remove.addEventListener('click', () => { state = removeExpeditionTask(state, dataset, task.id); persist(); renderPlanner(); renderSearch(); });
          controls.append(remove);
          header.append(check, title, controls);
          const note = document.createElement('textarea');
          note.rows = 2;
          note.maxLength = 2000;
          note.placeholder = 'Private session note, route reminder or equipment preparation…';
          note.value = task.note;
          note.addEventListener('change', () => { state = updateExpeditionTask(state, dataset, task.id, { note: note.value }); persist(); announce('Expedition note saved locally.'); });
          const open = document.createElement('a');
          open.href = record.href;
          open.textContent = 'Open related guide →';
          body.append(header, note, open);
          article.append(image, body);
          return article;
        });
        plannerList.replaceChildren(...nodes);
        if (plannerEmpty instanceof HTMLElement) plannerEmpty.hidden = state.tasks.length !== 0;
        if (plannerDone) plannerDone.textContent = String(state.tasks.filter((task) => task.done).length);
        if (plannerTotal) plannerTotal.textContent = String(state.tasks.length);
        if (plannerSelect instanceof HTMLSelectElement) {
          for (const option of plannerSelect.options) option.disabled = option.value !== '' && state.tasks.some((task) => task.recordId === option.value);
          if (plannerSelect.selectedOptions[0]?.disabled) plannerSelect.value = '';
        }
      };

      search?.addEventListener('input', renderSearch);
      type?.addEventListener('change', renderSearch);
      root.querySelector('[data-command-clear]')?.addEventListener('click', () => {
        if (search instanceof HTMLInputElement) search.value = '';
        if (type instanceof HTMLSelectElement) type.value = 'all';
        renderSearch();
        search?.focus();
      });

      profile?.addEventListener('change', () => {
        if (!(profile instanceof HTMLSelectElement)) return;
        state = setSpoilerProfile(state, dataset, profile.value);
        persist();
        renderProfile();
        renderSearch();
        renderPlanner();
        window.dispatchEvent(new CustomEvent('crimson-desert:spoiler-profile'));
        announce(`Spoiler profile changed to ${profile.selectedOptions[0]?.textContent ?? profile.value}.`);
      });

      root.querySelector('[data-planner-add]')?.addEventListener('click', () => {
        if (!(plannerSelect instanceof HTMLSelectElement) || !plannerSelect.value) return;
        const record = records.get(plannerSelect.value);
        state = addExpeditionTask(state, dataset, plannerSelect.value);
        persist();
        plannerSelect.value = '';
        renderPlanner();
        renderSearch();
        announce(`${displayTitle(record)} added to the expedition.`);
      });

      root.querySelector('[data-planner-reset]')?.addEventListener('click', () => {
        if (!window.confirm('Clear every objective from the current expedition plan?')) return;
        state.tasks = [];
        persist();
        renderPlanner();
        renderSearch();
        announce('Expedition plan cleared.');
      });

      root.querySelector('[data-vault-export]')?.addEventListener('click', () => {
        try {
          const vault = createGuideVault(window.localStorage, state, dataset);
          const blob = new Blob([JSON.stringify(vault, null, 2)], { type: 'application/json' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = `crimson-desert-guide-vault-${new Date().toISOString().slice(0, 10)}.json`;
          link.click();
          URL.revokeObjectURL(link.href);
          announce(`Complete guide vault exported with ${Object.keys(vault.entries).length} supported state sources.`);
        } catch (error) {
          announce(error instanceof Error ? error.message : 'Guide vault could not be exported.', true);
        }
      });

      root.querySelector('[data-vault-import]')?.addEventListener('click', () => vaultFile?.click());
      vaultFile?.addEventListener('change', async () => {
        if (!(vaultFile instanceof HTMLInputElement) || !vaultFile.files?.[0]) return;
        try {
          const raw = JSON.parse(await vaultFile.files[0].text());
          state = restoreGuideVault(window.localStorage, raw, dataset);
          renderProfile();
          renderProgress();
          renderResume();
          renderPlanner();
          renderSearch();
          window.dispatchEvent(new CustomEvent('crimson-desert:spoiler-profile'));
          announce('Guide vault validated and restored. Reload other open guide tabs before continuing work.');
        } catch (error) {
          announce(error instanceof Error ? error.message : 'Guide vault could not be restored.', true);
        } finally {
          vaultFile.value = '';
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return;
        event.preventDefault();
        search?.focus();
      });

      renderProfile();
      renderProgress();
      renderResume();
      renderPlanner();
      renderSearch();
    }
  };

  bindExpeditionCommand();
  document.addEventListener('astro:page-load', bindExpeditionCommand);
</script>

<style>
