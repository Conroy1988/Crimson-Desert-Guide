---
import atlas from '../../data/atlas.json';
const regionLabels = Object.fromEntries(atlas.regions.map((item) => [item.id, item.label]));
const serviceLabels = Object.fromEntries(atlas.services.map((item) => [item.id, item.label]));
---

<section class="pywel-atlas" data-pywel-atlas>
  <script id="pywel-atlas-data" type="application/json" set:html={JSON.stringify(atlas)}></script>

  <div class="atlas-hero">
    <div>
      <span>Topological world intelligence</span>
      <h2>Pywel Atlas</h2>
      <p>Search verified settlements, services and travel systems. This is deliberately not a coordinate map: unsupported geography remains unavailable rather than estimated.</p>
    </div>
    <dl>
      <div><dt>Regions</dt><dd>{atlas.regions.length}</dd></div>
      <div><dt>Locations</dt><dd>{atlas.locations.length}</dd></div>
      <div><dt>Services</dt><dd>{atlas.services.length}</dd></div>
      <div><dt>Verified links</dt><dd>{atlas.connections.length}</dd></div>
    </dl>
  </div>

  <aside class="atlas-boundary"><strong>No invented geography</strong><span>Coordinates, distances and settlement-to-settlement routes remain unavailable until directly verified.</span></aside>

  <div class="atlas-filters">
    <label><span>Search</span><input type="search" placeholder="Settlement, service, activity…" data-atlas-search /></label>
    <label><span>Region</span><select data-atlas-region><option value="all">All regions</option>{atlas.regions.map((item) => <option value={item.id}>{item.label}</option>)}</select></label>
    <label><span>Type</span><select data-atlas-type><option value="all">All types</option><option value="settlement">Settlements</option><option value="travel-node">Travel nodes</option><option value="travel-system">Travel systems</option><option value="camp">Camps</option><option value="discovery-system">Discovery systems</option></select></label>
    <label><span>Service</span><select data-atlas-service><option value="all">All services</option>{atlas.services.map((item) => <option value={item.id}>{item.label}</option>)}</select></label>
    <label><span>Spoilers</span><select data-atlas-spoiler><option value="safe">Hide major spoilers</option><option value="all">Show revealed records</option></select></label>
  </div>

  <div class="atlas-workspace">
    <aside class="atlas-planner">
      <header><span>Verified route planner</span><h3>Route intelligence</h3><p>Only documented graph edges are used. A missing route is reported rather than guessed.</p></header>
      <label><span>From</span><select data-route-from>{atlas.locations.map((item) => <option value={item.id}>{item.title}</option>)}</select></label>
      <label><span>To</span><select data-route-to>{atlas.locations.map((item) => <option value={item.id}>{item.title}</option>)}</select></label>
      <button type="button" data-route-plan>Find verified route</button>
      <div class="atlas-result" data-route-result aria-live="polite">Select two records to test the verified connection graph.</div>
      <hr />
      <label><span>Find a service</span><select data-service-finder><option value="">Choose a service</option>{atlas.services.map((item) => <option value={item.id}>{item.label}</option>)}</select></label>
      <div class="atlas-result" data-service-result aria-live="polite"></div>
      <hr />
      <div class="atlas-backup"><button type="button" data-atlas-export>Export</button><button type="button" data-atlas-import>Import</button><button type="button" data-atlas-reset>Reset</button><input type="file" accept="application/json" hidden data-atlas-file /></div>
      <p class="atlas-status" data-atlas-status aria-live="polite"></p>
    </aside>

    <div class="atlas-register">
      <header><div><span>Field register</span><h3>Verified locations and systems</h3></div><strong data-atlas-count>{atlas.locations.length} records</strong></header>
      <div class="atlas-regions">{atlas.regions.map((region) => <article><strong>{region.label}</strong><p>{region.description}</p></article>)}</div>
      <div class="atlas-cards">
        {atlas.locations.map((location) => (
          <article class="atlas-card" data-location-id={location.id} data-region={location.region} data-type={location.type} data-services={location.serviceIds.join(' ')} data-spoiler={location.spoilerLevel} data-search={`${location.title} ${location.summary} ${location.serviceIds.map((id) => serviceLabels[id]).join(' ')} ${location.notes.join(' ')}`.toLowerCase()}>
            <header>
              <div><span>{regionLabels[location.region]} · {location.type.replaceAll('-', ' ')}</span><h4 data-location-title>{location.spoilerLevel === 'full' ? 'Spoilered location' : location.title}</h4></div>
              <em>{location.evidence}</em>
            </header>
            <div class="atlas-spoiler" data-spoiler-copy hidden={location.spoilerLevel !== 'full'}><p>Major location identity is masked.</p><button type="button" data-reveal-location={location.id}>Reveal identity</button></div>
            <div data-location-content hidden={location.spoilerLevel === 'full'}>
              <p>{location.summary}</p>
              <div class="atlas-services">{location.serviceIds.length ? location.serviceIds.map((serviceId) => <label><input type="checkbox" data-service-check={`${location.id}:${serviceId}`} disabled={!location.progress.serviceCheckable} /><span>{serviceLabels[serviceId]}</span></label>) : <span>No verified service record</span>}</div>
              <ul>{location.notes.map((note) => <li>{note}</li>)}</ul>
              <a href={location.guidePath}>Open related guide →</a>
            </div>
            <footer>
              {location.progress.visitable && <label><input type="checkbox" data-visited={location.id} /> Visited</label>}
              {location.progress.activatable && <label><input type="checkbox" data-activated={location.id} /> Activated</label>}
              <small>Patch {atlas.gamePatch}</small>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { createEmptyAtlasState, decodeAtlasBackup, encodeAtlasBackup, findVerifiedRoute, normaliseAtlasState } from '../lib/atlas-state.mjs';

  const bindAtlas = () => {
    for (const root of document.querySelectorAll('[data-pywel-atlas]')) {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') continue;
      root.dataset.bound = 'true';
      const node = root.querySelector('#pywel-atlas-data');
      if (!(node instanceof HTMLScriptElement)) continue;
      const dataset = JSON.parse(node.textContent || '{}');
      const locations = new Map(dataset.locations.map((item) => [item.id, item]));
      const services = new Map(dataset.services.map((item) => [item.id, item]));
      const status = root.querySelector('[data-atlas-status]');
      const announce = (message, failure = false) => { if (status instanceof HTMLElement) { status.textContent = message; status.dataset.failure = String(failure); } };

      let state;
      try {
        const stored = localStorage.getItem(dataset.storageKey);
        state = stored ? normaliseAtlasState(dataset, JSON.parse(stored)) : createEmptyAtlasState(dataset);
      } catch {
        state = createEmptyAtlasState(dataset);
        announce('Stored atlas progress was invalid and was not loaded.', true);
      }
      const save = () => { state.updatedAt = new Date().toISOString(); localStorage.setItem(dataset.storageKey, JSON.stringify(state)); };
      const toggle = (key, value, enabled) => { const values = new Set(state[key]); enabled ? values.add(value) : values.delete(value); state[key] = [...values].sort(); save(); };

      const applyState = () => {
        for (const input of root.querySelectorAll('[data-visited]')) if (input instanceof HTMLInputElement) input.checked = state.visited.includes(input.dataset.visited);
        for (const input of root.querySelectorAll('[data-activated]')) if (input instanceof HTMLInputElement) input.checked = state.activated.includes(input.dataset.activated);
        for (const input of root.querySelectorAll('[data-service-check]')) if (input instanceof HTMLInputElement) input.checked = state.checkedServices.includes(input.dataset.serviceCheck);
        for (const card of root.querySelectorAll('[data-location-id]')) {
          if (!(card instanceof HTMLElement)) continue;
          const record = locations.get(card.dataset.locationId);
          const revealed = record.spoilerLevel !== 'full' || state.revealed.includes(record.id);
          const title = card.querySelector('[data-location-title]');
          const content = card.querySelector('[data-location-content]');
          const spoiler = card.querySelector('[data-spoiler-copy]');
          if (title instanceof HTMLElement) title.textContent = revealed ? record.title : 'Spoilered location';
          if (content instanceof HTMLElement) content.hidden = !revealed;
          if (spoiler instanceof HTMLElement) spoiler.hidden = revealed;
        }
      };

      for (const input of root.querySelectorAll('[data-visited]')) input.addEventListener('change', () => toggle('visited', input.dataset.visited, input.checked));
      for (const input of root.querySelectorAll('[data-activated]')) input.addEventListener('change', () => toggle('activated', input.dataset.activated, input.checked));
      for (const input of root.querySelectorAll('[data-service-check]')) input.addEventListener('change', () => toggle('checkedServices', input.dataset.serviceCheck, input.checked));
      for (const button of root.querySelectorAll('[data-reveal-location]')) button.addEventListener('click', () => { toggle('revealed', button.dataset.revealLocation, true); applyState(); filterCards(); });

      const search = root.querySelector('[data-atlas-search]');
      const region = root.querySelector('[data-atlas-region]');
      const type = root.querySelector('[data-atlas-type]');
      const service = root.querySelector('[data-atlas-service]');
      const spoiler = root.querySelector('[data-atlas-spoiler]');
      const count = root.querySelector('[data-atlas-count]');
      const filterCards = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        let visible = 0;
        for (const card of root.querySelectorAll('[data-location-id]')) {
          if (!(card instanceof HTMLElement)) continue;
          const record = locations.get(card.dataset.locationId);
          const revealed = record.spoilerLevel !== 'full' || state.revealed.includes(record.id);
          const matches = (!query || card.dataset.search.includes(query) || (revealed && record.title.toLowerCase().includes(query))) && (!(region instanceof HTMLSelectElement) || region.value === 'all' || card.dataset.region === region.value) && (!(type instanceof HTMLSelectElement) || type.value === 'all' || card.dataset.type === type.value) && (!(service instanceof HTMLSelectElement) || service.value === 'all' || card.dataset.services.split(' ').includes(service.value)) && (!(spoiler instanceof HTMLSelectElement) || spoiler.value === 'all' || record.spoilerLevel !== 'full' || revealed);
          card.hidden = !matches;
          if (matches) visible += 1;
        }
        if (count instanceof HTMLElement) count.textContent = `${visible} ${visible === 1 ? 'record' : 'records'}`;
      };
      for (const control of [search, region, type, service, spoiler]) control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', filterCards);

      const from = root.querySelector('[data-route-from]');
      const to = root.querySelector('[data-route-to]');
      const routeResult = root.querySelector('[data-route-result]');
      root.querySelector('[data-route-plan]')?.addEventListener('click', () => {
        if (!(from instanceof HTMLSelectElement) || !(to instanceof HTMLSelectElement) || !(routeResult instanceof HTMLElement)) return;
        const route = findVerifiedRoute(dataset, from.value, to.value);
        if (!route) { routeResult.innerHTML = '<strong>No verified route.</strong><span>The atlas will not invent a path. Confirm the connection in-game.</span>'; return; }
        const names = route.locationIds.map((id) => locations.get(id)?.title ?? id);
        routeResult.innerHTML = `<strong>${names.join(' → ')}</strong><span>${route.connectionIds.length} verified connection${route.connectionIds.length === 1 ? '' : 's'}.</span>`;
      });

      const serviceFinder = root.querySelector('[data-service-finder]');
      const serviceResult = root.querySelector('[data-service-result]');
      serviceFinder?.addEventListener('change', () => {
        if (!(serviceFinder instanceof HTMLSelectElement) || !(serviceResult instanceof HTMLElement)) return;
        const selected = serviceFinder.value;
        if (!selected) { serviceResult.textContent = ''; return; }
        const matches = dataset.locations.filter((item) => item.serviceIds.includes(selected));
        const label = services.get(selected)?.label ?? selected;
        serviceResult.innerHTML = matches.length ? `<strong>${label}</strong><span>${matches.map((item) => item.spoilerLevel === 'full' && !state.revealed.includes(item.id) ? 'Spoilered location' : item.title).join(' · ')}</span>` : `<strong>${label}</strong><span>No verified location currently offers this service.</span>`;
      });

      const fileInput = root.querySelector('[data-atlas-file]');
      root.querySelector('[data-atlas-export]')?.addEventListener('click', () => { const blob = new Blob([encodeAtlasBackup(dataset, state)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `crimson-desert-atlas-${dataset.datasetVersion}.json`; link.click(); URL.revokeObjectURL(link.href); announce('Atlas progress exported.'); });
      root.querySelector('[data-atlas-import]')?.addEventListener('click', () => fileInput?.click());
      fileInput?.addEventListener('change', async () => { if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) return; try { state = decodeAtlasBackup(dataset, await fileInput.files[0].text()); save(); applyState(); filterCards(); announce('Atlas backup imported successfully.'); } catch (error) { announce(error instanceof Error ? error.message : 'Atlas backup could not be imported.', true); } finally { fileInput.value = ''; } });
      root.querySelector('[data-atlas-reset]')?.addEventListener('click', () => { if (!window.confirm('Reset all visited locations, activated nodes and service checks?')) return; state = createEmptyAtlasState(dataset); save(); applyState(); filterCards(); announce('Atlas progress reset.'); });

      applyState();
      filterCards();
    }
  };
  bindAtlas();
  document.addEventListener('astro:page-load', bindAtlas);
</script>

<style>
  .pywel-atlas{display:grid;gap:1.2rem}.atlas-hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(18rem,.7fr);gap:1.5rem;padding:clamp(1.2rem,3vw,2rem);border:1px solid rgb(206 153 65 / 32%);border-radius:.9rem;background:radial-gradient(circle at 100% 0,rgb(151 42 29 / 18%),transparent 35%),linear-gradient(135deg,rgb(255 255 255 / 3%),transparent),#0d0d0b;box-shadow:0 1.5rem 4rem rgb(0 0 0 / 24%)}.atlas-hero>div>span,.atlas-register>header span,.atlas-planner header>span{font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#d5ab61}.atlas-hero h2,.atlas-register h3,.atlas-planner h3{margin:.25rem 0;font-family:var(--cd-font-display);color:var(--sl-color-white)}.atlas-hero h2{font-size:clamp(2.2rem,5vw,4.2rem)}.atlas-hero p,.atlas-planner p{color:var(--sl-color-gray-2)}.atlas-hero dl{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin:0}.atlas-hero dl div{display:grid;padding:.8rem;border:1px solid var(--cd-border);border-radius:.55rem;background:rgb(0 0 0 / 20%)}.atlas-hero dt{font-size:.65rem;text-transform:uppercase;color:var(--sl-color-gray-3)}.atlas-hero dd{margin:0;font-family:var(--cd-font-display);font-size:1.7rem;color:#efcc88}.atlas-boundary{display:flex;gap:.8rem;align-items:center;padding:.8rem 1rem;border-left:3px solid #b84a32;background:rgb(128 38 27 / 12%)}.atlas-boundary span{color:var(--sl-color-gray-2)}.atlas-filters{display:grid;grid-template-columns:2fr repeat(4,minmax(9rem,1fr));gap:.7rem}.pywel-atlas label{display:grid;gap:.3rem;font-size:.72rem;font-weight:700;color:var(--sl-color-gray-3)}.pywel-atlas input,.pywel-atlas select,.pywel-atlas button{min-height:2.7rem;border:1px solid var(--cd-border);border-radius:.45rem;background:var(--cd-surface);color:var(--sl-color-gray-1)}.pywel-atlas input,.pywel-atlas select{padding:.55rem .65rem}.pywel-atlas button{padding:.55rem .75rem;cursor:pointer;font-weight:800}.pywel-atlas button:hover{border-color:#c99645}.atlas-workspace{display:grid;grid-template-columns:minmax(16rem,22rem) minmax(0,1fr);gap:1rem;align-items:start}.atlas-planner{position:sticky;top:calc(var(--sl-nav-height) + 1rem);display:grid;gap:.8rem;padding:1rem;border:1px solid rgb(202 151 68 / 28%);border-radius:.75rem;background:var(--cd-surface)}.atlas-planner hr{width:100%;border:0;border-top:1px solid var(--cd-border)}.atlas-result{display:grid;gap:.25rem;min-height:3.8rem;padding:.75rem;border:1px solid var(--cd-border);border-radius:.5rem;background:rgb(0 0 0 / 12%)}.atlas-result span{color:var(--sl-color-gray-3);font-size:.78rem}.atlas-backup{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}.atlas-status{min-height:1.2rem;margin:0;font-size:.75rem;color:#8fc59b}.atlas-status[data-failure=true]{color:#e18672}.atlas-register{display:grid;gap:1rem}.atlas-register>header{display:flex;justify-content:space-between;align-items:end;gap:1rem}.atlas-register>header strong{color:#d7b46f}.atlas-regions{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.atlas-regions article{padding:.8rem;border:1px solid var(--cd-border);border-radius:.55rem;background:var(--cd-surface)}.atlas-regions p{margin:.3rem 0 0;font-size:.78rem;color:var(--sl-color-gray-3)}.atlas-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.atlas-card{display:grid;gap:.8rem;padding:1rem;border:1px solid var(--cd-border);border-radius:.7rem;background:linear-gradient(145deg,rgb(255 255 255 / 2%),transparent 45%),var(--cd-surface);box-shadow:0 .8rem 2rem rgb(0 0 0 / 10%)}.atlas-card[hidden]{display:none}.atlas-card>header{display:flex;justify-content:space-between;gap:1rem}.atlas-card>header span{font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;color:#c99b4f}.atlas-card h4{margin:.2rem 0 0;font-family:var(--cd-font-display);font-size:1.35rem;color:var(--sl-color-gray-1)}.atlas-card em{height:fit-content;padding:.25rem .45rem;border:1px solid var(--cd-border);border-radius:999px;font-size:.62rem;font-style:normal;text-transform:uppercase;color:var(--sl-color-gray-3)}.atlas-card p,.atlas-card li{color:var(--sl-color-gray-2)}.atlas-services{display:flex;flex-wrap:wrap;gap:.35rem}.atlas-services label{display:flex;gap:.35rem;align-items:center;padding:.3rem .45rem;border:1px solid var(--cd-border);border-radius:999px}.atlas-services input,.atlas-card footer input{min-height:auto}.atlas-card ul{margin:.2rem 0;padding-left:1.1rem;font-size:.8rem}.atlas-card a{color:var(--sl-color-accent-high)}.atlas-card footer{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:center;padding-top:.7rem;border-top:1px solid var(--cd-border)}.atlas-card footer label{display:flex;gap:.35rem;align-items:center}.atlas-card footer small{margin-left:auto;color:var(--sl-color-gray-4)}.atlas-spoiler{display:grid;gap:.5rem;padding:.8rem;border:1px solid rgb(171 52 36 / 38%);border-radius:.5rem;background:rgb(104 30 22 / 12%)}:root[data-theme=light] .atlas-hero{background:radial-gradient(circle at 100% 0,rgb(151 42 29 / 10%),transparent 35%),#f5ede1}:root[data-theme=light] .atlas-planner,:root[data-theme=light] .atlas-card,:root[data-theme=light] .atlas-regions article{background:#fffaf2}@media(max-width:70rem){.atlas-filters{grid-template-columns:repeat(2,1fr)}.atlas-workspace{grid-template-columns:1fr}.atlas-planner{position:static}}@media(max-width:46rem){.atlas-hero{grid-template-columns:1fr}.atlas-cards,.atlas-regions,.atlas-filters,.atlas-backup{grid-template-columns:1fr}}
</style>
