---
import patch from '../../data/current-patch.json';
import completion from '../../data/completion.json';
import technical from '../../data/technical-issues.json';

const steamRoot = 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3321460';
const heroImage = `${steamRoot}/669119c3747653f41a46c59f213168448d094e04/ss_669119c3747653f41a46c59f213168448d094e04.1920x1080.jpg?t=1781661893`;

const guideCards = [
  {
    title: 'Beginner Guide',
    description: 'Essential priorities, settings, saves and early systems without costly mistakes.',
    href: '/start-here/beginner-roadmap/',
    icon: 'book',
    image: `${steamRoot}/4b178bdd24ed576458116d8d3383b5352dad0fae/ss_4b178bdd24ed576458116d8d3383b5352dad0fae.1920x1080.jpg?t=1781661893`,
  },
  {
    title: 'Combat & Gear',
    description: 'Master defence, positioning, weapons, skills, refinement and extraction.',
    href: '/systems/combat/',
    icon: 'swords',
    image: `${steamRoot}/55e514af688f459364b3d0ffb288faf73580c8e5/ss_55e514af688f459364b3d0ffb288faf73580c8e5.1920x1080.jpg?t=1781661893`,
  },
  {
    title: 'World & Mounts',
    description: 'Regions, services, Abyss travel, special mounts and traversal intelligence.',
    href: '/world/',
    icon: 'horse',
    image: `${steamRoot}/d889c95c5f37b3a081cc7be68daf4ad2ffb9e291/ss_d889c95c5f37b3a081cc7be68daf4ad2ffb9e291.1920x1080.jpg?t=1781661893`,
  },
  {
    title: 'Completion Companion',
    description: 'Local-first checklists, spoiler controls, progress filters and JSON backups.',
    href: '/completion/',
    icon: 'trophy',
    image: `${steamRoot}/ab4e6544853a3ecb4e1e714b0fa706c50144fbbb/ss_ab4e6544853a3ecb4e1e714b0fa706c50144fbbb.1920x1080.jpg?t=1781661893`,
  },
  {
    title: 'Technical Centre',
    description: 'Platform-specific known issues, safe diagnostics and performance guidance.',
    href: '/technical/',
    icon: 'gear',
    image: `${steamRoot}/17861390a1d7e6bbf3c44854605c63d68127afac/ss_17861390a1d7e6bbf3c44854605c63d68127afac.1920x1080.jpg?t=1781661893`,
  },
];

const quickLinks = [
  { label: 'Guide search', detail: 'Find any topic', icon: 'search', action: 'search' },
  { label: 'Completion', detail: `${completion.entries.length} milestones`, icon: 'check', href: '/completion/' },
  { label: 'Patch notes', detail: `Version ${patch.version}`, icon: 'compass', href: '/patch-notes/' },
  { label: 'World services', detail: 'Routes and hubs', icon: 'pin', href: '/world/' },
  { label: 'Known issues', detail: `${technical.knownIssuesSource.issueCount} official records`, icon: 'warning', href: '/technical/' },
  { label: 'Content database', detail: '67 sourced records', icon: 'scroll', href: '/database/' },
];

const guideSections = [
  { label: 'Start Here', count: 4, width: 100 },
  { label: 'Core Systems', count: 4, width: 100 },
  { label: 'World & Mounts', count: 4, width: 100 },
  { label: 'Database', count: 1, width: 25 },
  { label: 'Completion', count: 1, width: 25 },
  { label: 'Technical', count: 1, width: 25 },
];

const officialIssues = technical.records
  .filter((record) => record.kind === 'official-issue')
  .slice(0, 3);

const latestUpdates = [
  {
    label: 'Design',
    title: 'Cinematic Crimson Desert portal',
    description: 'A complete homepage rebuild with real guide routes and official public artwork.',
    href: '/update-log/',
  },
  {
    label: 'Accessibility',
    title: 'Light-mode contrast remediated',
    description: 'Dedicated contrast rules now protect readable labels, status colours and controls.',
    href: '/update-log/',
  },
  {
    label: 'Technical',
    title: 'Known Issues monitored every six hours',
    description: 'Official issue changes are fingerprinted and opened for review automatically.',
    href: '/technical/',
  },
];

const verifiedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${patch.verifiedAt}T00:00:00Z`));
---

<div class="cd-portal-home">
  <svg class="portal-symbols" aria-hidden="true">
    <symbol id="portal-icon-book" viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5Zm16 0A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z"/></symbol>
    <symbol id="portal-icon-swords" viewBox="0 0 24 24"><path d="m4 3 7 7-2 2-7-7 2-2Zm16 0-7 7 2 2 7-7-2-2ZM8 13l3 3-5 5H3v-3l5-5Zm8 0-3 3 5 5h3v-3l-5-5Z"/></symbol>
    <symbol id="portal-icon-horse" viewBox="0 0 24 24"><path d="M6 20v-7l3-5 1-5 3 3 4-2v4l3 3-2 5-5 1-2 3H6Zm6-8 2 1 2-2-4 1Z"/></symbol>
    <symbol id="portal-icon-trophy" viewBox="0 0 24 24"><path d="M7 3h10v3h4v2c0 4-2 6-6 6a5 5 0 0 1-2 2v2h4v3H7v-3h4v-2a5 5 0 0 1-2-2c-4 0-6-2-6-6V6h4V3Zm0 5H5c0 2 1 3 3 3L7 8Zm10 0-1 3c2 0 3-1 3-3h-2Z"/></symbol>
    <symbol id="portal-icon-gear" viewBox="0 0 24 24"><path d="m10 2 1 3h2l1-3 3 1-1 3 2 1 2-2 2 3-3 2v2l3 1-1 3-3-1-1 2 2 2-3 2-2-3h-2l-1 3-3-1 1-3-2-1-2 2-2-3 3-2v-2L2 10l1-3 3 1 1-2-2-2 3-2 2 3h2l-2-3Zm2 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></symbol>
    <symbol id="portal-icon-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></symbol>
    <symbol id="portal-icon-check" viewBox="0 0 24 24"><path d="M5 4h14v16H5V4Zm3 8 3 3 6-7"/></symbol>
    <symbol id="portal-icon-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/></symbol>
    <symbol id="portal-icon-pin" viewBox="0 0 24 24"><path d="M12 22s7-6 7-13a7 7 0 1 0-14 0c0 7 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></symbol>
    <symbol id="portal-icon-warning" viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3v1"/></symbol>
    <symbol id="portal-icon-scroll" viewBox="0 0 24 24"><path d="M6 3h12v15a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3h12V6H6v9H3V6a3 3 0 0 1 3-3Z"/></symbol>
    <symbol id="portal-icon-github" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3 19.5v-2.2c-2 .4-2.5-.8-2.5-.8-.3-.8-.8-1-1-1.1-.7-.5.1-.5.1-.5.8 0 1.2.8 1.2.8.7 1.2 1.8.9 2.2.7.1-.5.3-.9.5-1.1-1.6-.2-3.3-.8-3.3-3.6 0-.8.3-1.5.8-2-.1-.2-.4-1 .1-2 0 0 .7-.2 2.1.8a7.4 7.4 0 0 1 3.8 0c1.5-1 2.1-.8 2.1-.8.5 1 .2 1.8.1 2 .5.6.8 1.2.8 2 0 2.8-1.7 3.4-3.3 3.6.3.2.5.7.5 1.4v2.8A10 10 0 0 0 12 2Z"/></symbol>
  </svg>

  <header class="portal-nav">
    <a class="portal-brand" href="/" aria-label="Crimson Desert Guide home">
      <img src="/favicon.svg" alt="" width="48" height="48" />
      <span><strong>Crimson Desert</strong><small>Guide</small></span>
    </a>

    <nav class="portal-nav__links" aria-label="Homepage navigation" data-portal-links>
      <a href="/start-here/beginner-roadmap/">Beginner</a>
      <a href="/systems/combat/">Combat & Gear</a>
      <a href="/world/">World & Mounts</a>
      <a href="/completion/">Completion</a>
      <a href="/technical/">Technical</a>
      <a href="/patch-notes/">Patch Notes</a>
    </nav>

    <div class="portal-nav__actions">
      <button class="portal-icon-button" type="button" aria-label="Search the guide" data-home-search>
        <svg aria-hidden="true"><use href="#portal-icon-search"></use></svg>
      </button>
      <a class="portal-track" href="/completion/">
        <svg aria-hidden="true"><use href="#portal-icon-check"></use></svg>
        <span>Track progress</span>
      </a>
      <button class="portal-menu" type="button" aria-label="Toggle navigation" aria-expanded="false" data-portal-menu>
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main class="portal-main">
    <section class="portal-hero" style={`--portal-hero-art: url('${heroImage}')`} aria-labelledby="portal-title">
      <div class="portal-hero__shade" aria-hidden="true"></div>
      <div class="portal-hero__content">
        <p class="portal-kicker">The evidence-led companion to Pywel</p>
        <h1 id="portal-title"><span>Crimson Desert</span><small>Guide</small></h1>
        <p class="portal-hero__lede">Master the systems, read the world and finish the journey with patch-aware guidance that separates verified facts from speculation.</p>
        <div class="portal-hero__actions">
          <a class="portal-cta portal-cta--primary" href="/start-here/beginner-roadmap/">
            <svg aria-hidden="true"><use href="#portal-icon-book"></use></svg>
            <span><strong>Start your journey</strong><small>New to Crimson Desert?</small></span>
            <i aria-hidden="true">→</i>
          </a>
          <a class="portal-cta" href="/world/">
            <svg aria-hidden="true"><use href="#portal-icon-compass"></use></svg>
            <span><strong>Explore the world</strong><small>Routes, services and mounts</small></span>
            <i aria-hidden="true">→</i>
          </a>
        </div>
      </div>

      <a class="portal-patch-badge" href="/patch-notes/" aria-label={`Open Patch ${patch.version} notes`}>
        <span>Patch</span><strong>{patch.version}</strong><small>Live now</small>
        <svg aria-hidden="true"><use href="#portal-icon-compass"></use></svg>
      </a>
    </section>

    <section class="portal-section" aria-labelledby="portal-guides-title">
      <div class="portal-section__heading">
        <div><span>Choose your path</span><h2 id="portal-guides-title">Enter the guide through your objective.</h2></div>
        <p>Every section is tied to the same patch, evidence and spoiler-control system.</p>
      </div>

      <div class="portal-guide-grid">
        {guideCards.map((card) => (
          <a class="portal-guide-card" href={card.href}>
            <span class="portal-guide-card__art" style={`background-image: url('${card.image}')`} aria-hidden="true"></span>
            <span class="portal-guide-card__veil" aria-hidden="true"></span>
            <span class="portal-guide-card__icon"><svg aria-hidden="true"><use href={`#portal-icon-${card.icon}`}></use></svg></span>
            <span class="portal-guide-card__copy"><strong>{card.title}</strong><small>{card.description}</small></span>
            <span class="portal-guide-card__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="portal-quick" aria-label="Quick guide tools">
      <div class="portal-quick__label"><span>⚡</span><strong>Quick access</strong></div>
      <div class="portal-quick__links">
        {quickLinks.map((item) => item.action === 'search' ? (
          <button type="button" data-home-search>
            <svg aria-hidden="true"><use href={`#portal-icon-${item.icon}`}></use></svg>
            <span><strong>{item.label}</strong><small>{item.detail}</small></span>
          </button>
        ) : (
          <a href={item.href}>
            <svg aria-hidden="true"><use href={`#portal-icon-${item.icon}`}></use></svg>
            <span><strong>{item.label}</strong><small>{item.detail}</small></span>
          </a>
        ))}
      </div>
    </section>

    <section class="portal-dashboard" aria-label="Current guide intelligence">
      <article class="portal-panel portal-panel--library">
        <header><span>✦</span><h2>Guide library</h2></header>
        <div class="portal-library__summary"><strong>19</strong><span>live guide pages</span></div>
        <div class="portal-library__rows">
          {guideSections.map((section) => (
            <div><span><strong>{section.label}</strong><small>{section.count} {section.count === 1 ? 'guide' : 'guides'}</small></span><i><b style={`width:${section.width}%`}></b></i></div>
          ))}
        </div>
      </article>

      <article class="portal-panel portal-panel--patch">
        <header><svg aria-hidden="true"><use href="#portal-icon-compass"></use></svg><h2>Current patch</h2></header>
        <div class="portal-patch-number"><strong>{patch.version}</strong><span>Live</span></div>
        <p>Verified {verifiedLabel}</p>
        <a href="/patch-notes/">View patch intelligence <span aria-hidden="true">→</span></a>
      </article>

      <article class="portal-panel portal-panel--completion">
        <header><svg aria-hidden="true"><use href="#portal-icon-trophy"></use></svg><h2>Completion companion</h2></header>
        <div class="portal-completion__layout">
          <div class="portal-ring"><strong>{completion.entries.length}</strong><span>supported<br />milestones</span></div>
          <dl>
            <div><dt>Categories</dt><dd>{completion.categories.length}</dd></div>
            <div><dt>Storage</dt><dd>Local only</dd></div>
            <div><dt>Account</dt><dd>Not required</dd></div>
          </dl>
        </div>
        <a href="/completion/">Open your checklist <span aria-hidden="true">→</span></a>
      </article>

      <article class="portal-panel portal-panel--issues">
        <header><svg aria-hidden="true"><use href="#portal-icon-warning"></use></svg><h2>Known issues</h2></header>
        <div class="portal-issues__list">
          {officialIssues.map((issue) => (
            <a href="/technical/"><span class={`portal-severity portal-severity--${issue.severity}`}>{issue.severity}</span><span><strong>{issue.title}</strong><small>{issue.status}</small></span><i aria-hidden="true">›</i></a>
          ))}
        </div>
        <a class="portal-panel__footer" href="/technical/">View all {technical.knownIssuesSource.issueCount} official issues <span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="portal-section portal-updates" aria-labelledby="latest-intelligence-title">
      <div class="portal-section__heading">
        <div><span>Live intelligence</span><h2 id="latest-intelligence-title">What changed recently.</h2></div>
        <a href="/update-log/">Full update log <span aria-hidden="true">→</span></a>
      </div>
      <div class="portal-update-grid">
        {latestUpdates.map((update) => (
          <a href={update.href}><span>{update.label}</span><strong>{update.title}</strong><p>{update.description}</p><i aria-hidden="true">Read more →</i></a>
        ))}
      </div>
    </section>

    <section class="portal-trust" aria-label="Project operating principles">
      <div><span>◈</span><p><strong>Evidence graded</strong><small>Official, verified, community or provisional</small></p></div>
      <div><span>↻</span><p><strong>Patch monitored</strong><small>Official updates checked every six hours</small></p></div>
      <div><span>◎</span><p><strong>No accounts</strong><small>Progress stays in your browser</small></p></div>
      <div><span>⌁</span><p><strong>No tracking</strong><small>No analytics or remote profile database</small></p></div>
      <div><span>♥</span><p><strong>Community project</strong><small>Independent and openly maintained</small></p></div>
    </section>

    <section class="portal-community" aria-labelledby="join-project-title">
      <div class="portal-community__crest" aria-hidden="true"><img src="/favicon.svg" alt="" width="96" height="96" /></div>
      <div><span>Help build the definitive guide</span><h2 id="join-project-title">Join the project.</h2><p>Report missing evidence, submit corrections or follow development directly on GitHub.</p></div>
      <div class="portal-community__actions">
        <a class="portal-cta portal-cta--primary" href="https://github.com/Conroy1988/Crimson-Desert-Guide"><svg aria-hidden="true"><use href="#portal-icon-github"></use></svg><span><strong>Open GitHub</strong><small>Repository and issues</small></span><i aria-hidden="true">→</i></a>
        <a href="/standards/evidence-policy/">Read the evidence policy</a>
      </div>
    </section>

    <p class="portal-disclaimer">Unofficial fan project. Crimson Desert and related trademarks remain the property of Pearl Abyss. Promotional screenshots are sourced from the official public Steam media feed.</p>
  </main>
</div>

<script>
  const bindPortalHome = () => {
    const roots = document.querySelectorAll('.cd-portal-home');
    for (const root of roots) {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') continue;
      root.dataset.bound = 'true';

      for (const trigger of root.querySelectorAll('[data-home-search]')) {
        trigger.addEventListener('click', () => {
          const searchTrigger = document.querySelector('site-search button[data-open-modal]');
          if (searchTrigger instanceof HTMLButtonElement) searchTrigger.click();
        });
      }

      const menu = root.querySelector('[data-portal-menu]');
      const links = root.querySelector('[data-portal-links]');
      if (menu instanceof HTMLButtonElement && links instanceof HTMLElement) {
        menu.addEventListener('click', () => {
          const open = menu.getAttribute('aria-expanded') !== 'true';
          menu.setAttribute('aria-expanded', String(open));
          links.dataset.open = String(open);
        });
        links.addEventListener('click', () => {
          menu.setAttribute('aria-expanded', 'false');
          links.dataset.open = 'false';
        });
      }
    }
  };

  bindPortalHome();
  document.addEventListener('astro:page-load', bindPortalHome);
</script>

<style>
  .cd-portal-home {
    --portal-bg: #080806;
    --portal-panel: #10100e;
    --portal-panel-raised: #161512;
    --portal-line: #4b3c27;
    --portal-line-soft: rgb(190 147 75 / 22%);
    --portal-gold: #d0a85d;
    --portal-gold-bright: #efd28c;
    --portal-crimson: #7c2018;
    --portal-crimson-bright: #b13d27;
    --portal-text: #e8ddc8;
    --portal-muted: #a89d8b;
    --portal-dim: #746b5f;
    min-height: 100vh;
    color: var(--portal-text);
    background:
      radial-gradient(circle at 50% -10%, rgb(154 54 29 / 20%), transparent 36rem),
      linear-gradient(180deg, #080806, #0b0a08 48%, #070706);
    font-family: var(--sl-font);
  }

  .portal-symbols { position: absolute; width: 0; height: 0; overflow: hidden; }
  .cd-portal-home svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .portal-guide-card__icon svg,
  .portal-cta svg,
  .portal-panel header svg,
  .portal-icon-button svg,
  .portal-track svg,
  .portal-quick svg { width: 1.25rem; height: 1.25rem; }
  #portal-icon-book,
  #portal-icon-swords,
  #portal-icon-horse,
  #portal-icon-trophy,
  #portal-icon-gear,
  #portal-icon-github { fill: currentColor; stroke: none; }

  .portal-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    min-height: 4.7rem;
    padding: 0.65rem clamp(1rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--portal-line-soft);
    background: rgb(7 7 6 / 94%);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
    backdrop-filter: blur(20px) saturate(115%);
  }

  .portal-brand { display: flex; gap: 0.8rem; align-items: center; color: var(--portal-text); text-decoration: none; }
  .portal-brand img { width: 2.55rem; height: 2.55rem; filter: sepia(0.35) saturate(1.4) drop-shadow(0 0.4rem 0.8rem rgb(208 168 93 / 20%)); }
  .portal-brand span { display: grid; line-height: 1; }
  .portal-brand strong { font-family: var(--cd-font-display); font-size: 1.25rem; font-weight: 500; letter-spacing: 0.025em; color: #e8d6b6; }
  .portal-brand small { margin-top: 0.35rem; font-size: 0.64rem; font-weight: 800; letter-spacing: 0.42em; text-transform: uppercase; color: var(--portal-gold); }

  .portal-nav__links { display: flex; gap: clamp(0.7rem, 1.7vw, 1.7rem); justify-content: center; align-items: center; }
  .portal-nav__links a { position: relative; padding-block: 0.5rem; color: #bcb09d; font-family: var(--cd-font-display); font-size: 0.87rem; text-decoration: none; white-space: nowrap; }
  .portal-nav__links a::after { position: absolute; right: 50%; bottom: 0; left: 50%; height: 1px; content: ''; background: var(--portal-gold); transition: right 160ms ease, left 160ms ease; }
  .portal-nav__links a:hover { color: var(--portal-gold-bright); }
  .portal-nav__links a:hover::after { right: 0; left: 0; }

  .portal-nav__actions { display: flex; gap: 0.55rem; align-items: center; }
  .portal-icon-button,
  .portal-menu { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 1px solid var(--portal-line); border-radius: 0.45rem; background: #11110f; color: var(--portal-gold-bright); cursor: pointer; }
  .portal-track { display: inline-flex; gap: 0.55rem; align-items: center; min-height: 2.75rem; padding: 0.55rem 0.85rem; border: 1px solid #795d2e; border-radius: 0.45rem; background: linear-gradient(135deg, rgb(151 103 32 / 18%), rgb(57 39 18 / 22%)); color: var(--portal-gold-bright); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
  .portal-menu { display: none; align-content: center; gap: 0.28rem; }
  .portal-menu span { display: block; width: 1.25rem; height: 1px; background: currentColor; }

  .portal-main { display: grid; gap: clamp(2.5rem, 5vw, 5rem); width: min(100%, 100rem); margin-inline: auto; padding: 0 1.25rem 3rem; }

  .portal-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(34rem, 68vw, 48rem);
    overflow: hidden;
    margin-inline: -1.25rem;
    border-bottom: 1px solid var(--portal-line);
    background-image: var(--portal-hero-art);
    background-position: center 34%;
    background-size: cover;
    box-shadow: inset 0 -8rem 8rem #080806;
  }
  .portal-hero::after { position: absolute; inset: 0; z-index: -1; content: ''; background: linear-gradient(90deg, rgb(5 5 4 / 96%) 0%, rgb(8 7 6 / 88%) 30%, rgb(9 7 6 / 32%) 62%, rgb(5 5 4 / 10%) 100%), linear-gradient(180deg, rgb(5 5 4 / 18%), transparent 54%, #080806 100%); }
  .portal-hero__shade { position: absolute; inset: 0; z-index: -2; background: radial-gradient(circle at 63% 18%, rgb(225 159 71 / 15%), transparent 30rem); }
  .portal-hero__content { position: absolute; z-index: 2; top: 50%; left: clamp(1.25rem, 5vw, 5rem); width: min(38rem, calc(100% - 2.5rem)); transform: translateY(-47%); }
