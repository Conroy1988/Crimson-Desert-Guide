---
const portals = [
  {
    index: '01',
    eyebrow: 'First hours',
    title: 'Start Here',
    description: 'A low-spoiler route through early priorities, settings and expensive mistakes.',
    href: '/start-here/beginner-roadmap/',
    accent: 'ember',
  },
  {
    index: '02',
    eyebrow: 'Learn the fight',
    title: 'Combat',
    description: 'Inputs, defensive states, counters, positioning and reproducible combat tests.',
    href: '/systems/combat/',
    accent: 'iron',
  },
  {
    index: '03',
    eyebrow: 'Build with intent',
    title: 'Gear & Refinement',
    description: 'Equipment, materials, extraction, sockets and upgrade decisions without guesswork.',
    href: '/systems/gear/',
    accent: 'gold',
  },
  {
    index: '04',
    eyebrow: 'Read the land',
    title: 'World Compendium',
    description: 'Settlements, services, routes and regional intelligence organised for practical use.',
    href: '/world/hernand/',
    accent: 'stone',
  },
  {
    index: '05',
    eyebrow: 'Spoiler controlled',
    title: 'Mounts & Creatures',
    description: 'Unlock conditions, traversal value and creature research behind explicit spoiler gates.',
    href: '/mounts/blackstar/',
    accent: 'crimson',
  },
  {
    index: '06',
    eyebrow: 'Finish deliberately',
    title: 'Completion',
    description: 'A structured path toward quests, bosses, discoveries, equipment and full completion.',
    href: '/completion/',
    accent: 'ash',
  },
  {
    index: '07',
    eyebrow: 'Make it run well',
    title: 'Technical',
    description: 'Platform-specific optimisation, troubleshooting and evidence-labelled workarounds.',
    href: '/technical/',
    accent: 'frost',
  },
];

const evidence = [
  ['Official', 'Directly supported by Pearl Abyss material.'],
  ['Verified', 'Reproduced through controlled testing.'],
  ['Community', 'Independently corroborated by credible reports.'],
  ['Provisional', 'Useful intelligence still awaiting confirmation.'],
];
---

<div class="cd-home">
  <section class="cd-hero" aria-labelledby="home-title">
    <div class="cd-hero__terrain" aria-hidden="true">
      <span class="terrain-line terrain-line--one"></span>
      <span class="terrain-line terrain-line--two"></span>
      <span class="terrain-line terrain-line--three"></span>
      <span class="terrain-mark terrain-mark--one"></span>
      <span class="terrain-mark terrain-mark--two"></span>
    </div>

    <div class="cd-hero__topline">
      <span class="cd-kicker">Independent field guide</span>
      <span class="cd-live"><i aria-hidden="true"></i> Live · Patch 1.14.00</span>
    </div>

    <div class="cd-hero__layout">
      <div class="cd-hero__copy">
        <p class="cd-overline">Crimson Desert Guide</p>
        <h1 id="_top">
          Know the land.<br />
          <span>Master the systems.</span><br />
          Finish the journey.
        </h1>
        <p class="cd-hero__lede">
          A patch-aware compendium built around evidence, reproducible testing and explicit spoiler control—not search-engine filler.
        </p>

        <div class="cd-actions">
          <a class="cd-button cd-button--primary" href="/start-here/beginner-roadmap/">
            Begin the guide
            <span aria-hidden="true">→</span>
          </a>
          <button class="cd-button cd-button--search" type="button" data-home-search aria-keyshortcuts="Control+K">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            Search everything
            <kbd>Ctrl K</kbd>
          </button>
        </div>
      </div>

      <aside class="cd-intel-card" aria-label="Current guide intelligence">
        <div class="cd-intel-card__header">
          <span>Current intelligence</span>
          <span class="cd-intel-card__signal" aria-hidden="true"></span>
        </div>
        <dl>
          <div>
            <dt>Guide baseline</dt>
            <dd>Version 1.14.00</dd>
          </div>
          <div>
            <dt>Last verified</dt>
            <dd>25 July 2026</dd>
          </div>
          <div>
            <dt>Patch surveillance</dt>
            <dd>Every 6 hours</dd>
          </div>
          <div>
            <dt>Account required</dt>
            <dd>Never</dd>
          </div>
        </dl>
        <a href="/patch-notes/">Open patch intelligence <span aria-hidden="true">↗</span></a>
      </aside>
    </div>

    <div class="cd-hero__metrics" aria-label="Guide operating metrics">
      <div><strong>13</strong><span>live guide pages</span></div>
      <div><strong>4</strong><span>evidence grades</span></div>
      <div><strong>6h</strong><span>official patch watch</span></div>
      <div><strong>0</strong><span>tracking accounts</span></div>
    </div>
  </section>

  <section class="cd-section" aria-labelledby="choose-path">
    <div class="cd-section__heading">
      <div>
        <p class="cd-overline">Navigate by objective</p>
        <h2 id="choose-path">Choose your path</h2>
      </div>
      <p>Enter through the problem you are solving. Every route leads back into the same patch-controlled knowledge system.</p>
    </div>

    <div class="cd-portals">
      {portals.map((portal) => (
        <a class={`cd-portal cd-portal--${portal.accent}`} href={portal.href}>
          <span class="cd-portal__index">{portal.index}</span>
          <span class="cd-portal__eyebrow">{portal.eyebrow}</span>
          <strong>{portal.title}</strong>
          <span class="cd-portal__description">{portal.description}</span>
          <span class="cd-portal__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="cd-section cd-intelligence" aria-labelledby="live-intelligence">
    <div class="cd-intelligence__primary">
      <p class="cd-overline">Live intelligence</p>
      <h2 id="live-intelligence">The guide knows when its knowledge may be stale.</h2>
      <p>
        Each page carries a patch baseline, verification date, evidence grade and spoiler level. When an official update appears, affected guidance can be withdrawn for review instead of remaining silently wrong.
      </p>
      <div class="cd-intelligence__actions">
        <a href="/update-log/">Read the update log <span aria-hidden="true">→</span></a>
        <a href="/standards/evidence-policy/">Inspect the evidence policy <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="cd-evidence" aria-label="Evidence grading system">
      {evidence.map(([title, description], index) => (
        <div class="cd-evidence__row">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{title}</strong>
            <p>{description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cd-section cd-operations" aria-labelledby="operating-model">
    <div>
      <p class="cd-overline">Operating model</p>
      <h2 id="operating-model">Useful first. Certain only when the evidence allows it.</h2>
    </div>
    <ol>
      <li><span>01</span><p><strong>Detect</strong>Official updates are checked automatically.</p></li>
      <li><span>02</span><p><strong>Quarantine</strong>Potentially affected pages are marked for review.</p></li>
      <li><span>03</span><p><strong>Verify</strong>Recommendations are sourced or reproduced.</p></li>
      <li><span>04</span><p><strong>Publish</strong>Validated changes deploy through protected GitHub checks.</p></li>
    </ol>
  </section>
</div>

<script>
  const bindHomeSearch = () => {
    const trigger = document.querySelector('[data-home-search]');
    if (!(trigger instanceof HTMLButtonElement) || trigger.dataset.bound === 'true') return;

    trigger.dataset.bound = 'true';
    trigger.addEventListener('click', () => {
      const searchTrigger = document.querySelector('site-search button[data-open-modal]');
      if (searchTrigger instanceof HTMLButtonElement) searchTrigger.click();
    });
  };

  bindHomeSearch();
  document.addEventListener('astro:page-load', bindHomeSearch);
</script>

<style>
  .cd-home {
    --home-line: color-mix(in srgb, var(--sl-color-gray-5) 68%, transparent);
    --home-panel: color-mix(in srgb, var(--sl-color-black) 78%, transparent);
    --home-panel-strong: color-mix(in srgb, var(--sl-color-gray-6) 88%, transparent);
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem);
    width: min(100%, 92rem);
    margin-inline: auto;
    padding: 1.5rem clamp(1rem, 4vw, 3rem) 6rem;
  }

  .cd-hero {
    position: relative;
    isolation: isolate;
    min-height: min(46rem, calc(100vh - 6rem));
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--home-line);
    border-radius: 1.25rem;
    background:
      linear-gradient(130deg, rgb(22 15 11 / 97%), rgb(12 9 7 / 90%) 56%, rgb(51 20 14 / 82%)),
      var(--sl-color-black);
    box-shadow: 0 3rem 8rem rgb(0 0 0 / 34%);
  }

  .cd-hero::before,
  .cd-hero::after {
    position: absolute;
    z-index: -2;
    content: '';
    border-radius: 999px;
    filter: blur(1px);
  }

  .cd-hero::before {
    top: -18rem;
    right: -15rem;
    width: 42rem;
    height: 42rem;
    background: radial-gradient(circle, rgb(192 52 28 / 34%), rgb(101 23 15 / 12%) 45%, transparent 70%);
  }

  .cd-hero::after {
    bottom: -22rem;
    left: -18rem;
    width: 50rem;
    height: 50rem;
    background: radial-gradient(circle, rgb(224 166 91 / 12%), transparent 65%);
  }

  .cd-hero__terrain {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    opacity: 0.8;
  }

  .terrain-line {
    position: absolute;
    width: 52rem;
    height: 21rem;
    border: 1px solid rgb(229 185 117 / 13%);
    border-radius: 48% 52% 42% 58%;
    transform: rotate(-16deg);
  }

  .terrain-line--one { right: -18rem; bottom: 3rem; }
  .terrain-line--two { right: -13rem; bottom: 8rem; transform: rotate(-11deg) scale(0.82); }
  .terrain-line--three { right: -6rem; bottom: 12rem; transform: rotate(-6deg) scale(0.62); }

  .terrain-mark {
    position: absolute;
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1px solid rgb(235 187 111 / 46%);
    transform: rotate(45deg);
  }

  .terrain-mark--one { right: 18%; top: 28%; }
  .terrain-mark--two { right: 35%; bottom: 22%; }

  .cd-hero__topline,
  .cd-hero__layout,
  .cd-hero__metrics {
    position: relative;
    z-index: 1;
  }

  .cd-hero__topline {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .cd-kicker,
  .cd-live,
  .cd-overline,
  .cd-portal__eyebrow {
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cd-kicker { color: var(--sl-color-gray-2); }

  .cd-live {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--sl-color-accent-high);
  }

  .cd-live i {
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #75b987;
    box-shadow: 0 0 0 0.25rem rgb(117 185 135 / 13%);
  }

  .cd-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    min-height: 31rem;
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .cd-overline {
    margin: 0 0 1rem;
    color: var(--sl-color-accent-high);
  }

  .cd-hero h1,
  .cd-section h2 {
    margin: 0;
    font-family: var(--cd-font-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--sl-color-white);
  }

  .cd-hero h1 {
    max-width: 13ch;
    font-size: clamp(3rem, 7.6vw, 7.2rem);
    line-height: 0.9;
  }

  .cd-hero h1 span {
    color: var(--sl-color-accent-high);
    font-style: italic;
  }

  .cd-hero__lede {
    max-width: 43rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.75;
    color: var(--sl-color-gray-2);
  }

  .cd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .cd-button {
    display: inline-flex;
    gap: 0.7rem;
    justify-content: center;
    align-items: center;
    min-height: 3rem;
    padding: 0.72rem 1rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.65rem;
    font: inherit;
    font-weight: 750;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .cd-button:hover { transform: translateY(-2px); }

  .cd-button--primary {
    border-color: var(--sl-color-accent);
    background: linear-gradient(135deg, #bd4325, #852818);
    color: #fff7ea;
    box-shadow: 0 0.8rem 2rem rgb(149 45 25 / 20%);
  }

  .cd-button--search {
    background: rgb(255 255 255 / 4%);
    color: var(--sl-color-gray-1);
  }

  .cd-button--search svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .cd-button kbd {
    margin-left: 0.2rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 0.3rem;
    background: rgb(0 0 0 / 18%);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .cd-intel-card {
    padding: 1.1rem;
    border: 1px solid rgb(232 187 116 / 18%);
    border-radius: 0.9rem;
    background: linear-gradient(155deg, rgb(255 255 255 / 6%), rgb(255 255 255 / 2%));
    backdrop-filter: blur(16px);
  }

  .cd-intel-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 9%);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }

  .cd-intel-card__signal {
    width: 1.2rem;
    height: 0.45rem;
    border-top: 1px solid var(--sl-color-accent-high);
    border-bottom: 1px solid var(--sl-color-accent-high);
    opacity: 0.75;
  }

  .cd-intel-card dl { margin: 0; }

  .cd-intel-card dl div {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.82rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 7%);
  }

  .cd-intel-card dt {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  .cd-intel-card dd {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--sl-color-gray-1);
    text-align: right;
  }

  .cd-intel-card > a {
    display: flex;
    justify-content: space-between;
    margin-top: 0.95rem;
    font-size: 0.82rem;
    font-weight: 750;
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }

  .cd-hero__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .cd-hero__metrics div {
    display: grid;
    gap: 0.25rem;
    padding: 1.2rem 1rem 0;
    border-right: 1px solid rgb(255 255 255 / 8%);
  }

  .cd-hero__metrics div:first-child { padding-left: 0; }
  .cd-hero__metrics div:last-child { border-right: 0; }

  .cd-hero__metrics strong {
    font-family: var(--cd-font-display);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--sl-color-accent-high);
  }

  .cd-hero__metrics span {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .cd-section {
    display: grid;
    gap: 2.25rem;
  }

  .cd-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 0.5fr);
    gap: 2rem;
    justify-content: space-between;
    align-items: end;
  }

  .cd-section h2 {
    max-width: 17ch;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 0.98;
  }

  .cd-section__heading > p,
  .cd-intelligence__primary > p {
    margin: 0;
    line-height: 1.75;
    color: var(--sl-color-gray-2);
  }

  .cd-portals {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.85rem;
  }

  .cd-portal {
    position: relative;
    display: flex;
    grid-column: span 4;
    flex-direction: column;
    min-height: 17.5rem;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid var(--home-line);
    border-radius: 0.9rem;
    background: var(--home-panel);
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .cd-portal:nth-child(1),
  .cd-portal:nth-child(4) { grid-column: span 5; }
  .cd-portal:nth-child(2),
  .cd-portal:nth-child(3) { grid-column: span 3.5; }
  .cd-portal:nth-child(5),
  .cd-portal:nth-child(6) { grid-column: span 3.5; }
  .cd-portal:nth-child(7) { grid-column: span 5; }

  .cd-portal::before {
    position: absolute;
    inset: auto -20% -65% 25%;
    height: 13rem;
    content: '';
    border-radius: 50%;
    background: radial-gradient(circle, var(--portal-glow, rgb(181 61 34 / 20%)), transparent 68%);
    transition: transform 220ms ease;
  }

  .cd-portal:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sl-color-accent) 62%, var(--home-line));
    background: var(--home-panel-strong);
  }

  .cd-portal:hover::before { transform: scale(1.2); }

  .cd-portal--gold { --portal-glow: rgb(207 152 77 / 22%); }
  .cd-portal--stone { --portal-glow: rgb(145 126 104 / 19%); }
  .cd-portal--frost { --portal-glow: rgb(92 139 147 / 18%); }
  .cd-portal--ash { --portal-glow: rgb(165 159 149 / 14%); }

  .cd-portal__index {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-4);
  }

  .cd-portal__eyebrow {
    margin-top: auto;
    color: var(--sl-color-accent-high);
  }

  .cd-portal strong {
    margin-top: 0.4rem;
    font-family: var(--cd-font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.15rem);
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .cd-portal__description {
    max-width: 32rem;
    margin-top: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .cd-portal__arrow {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    font-size: 1.1rem;
    color: var(--sl-color-gray-3);
  }

  .cd-intelligence {
    grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.72fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid var(--home-line);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 12% 10%, rgb(196 61 33 / 15%), transparent 32%),
      var(--home-panel);
  }

  .cd-intelligence__primary h2 { margin-bottom: 1.4rem; }

  .cd-intelligence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  .cd-intelligence__actions a {
    font-size: 0.86rem;
    font-weight: 750;
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }

  .cd-evidence {
    border-top: 1px solid var(--home-line);
  }

  .cd-evidence__row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--home-line);
  }

  .cd-evidence__row > span {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-4);
  }

  .cd-evidence__row strong {
    color: var(--sl-color-gray-1);
  }

  .cd-evidence__row p {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .cd-operations {
    grid-template-columns: minmax(0, 0.7fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
  }

  .cd-operations ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--home-line);
  }

  .cd-operations li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--home-line);
  }

  .cd-operations li > span {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-accent);
  }

  .cd-operations li p {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .cd-operations li strong {
    font-size: 1rem;
    color: var(--sl-color-gray-1);
  }

  @media (max-width: 72rem) {
    .cd-portal,
    .cd-portal:nth-child(n) { grid-column: span 6; }
  }

  @media (max-width: 56rem) {
    .cd-home { padding-inline: 0.5rem; }
    .cd-hero__layout,
    .cd-section__heading,
    .cd-intelligence,
    .cd-operations { grid-template-columns: 1fr; }
    .cd-hero__layout { min-height: auto; }
    .cd-intel-card { max-width: 30rem; }
    .cd-hero__metrics { grid-template-columns: repeat(2, 1fr); }
    .cd-hero__metrics div:nth-child(2) { border-right: 0; }
    .cd-hero__metrics div:nth-child(n + 3) { border-top: 1px solid rgb(255 255 255 / 8%); }
    .cd-hero__metrics div:nth-child(3) { padding-left: 0; }
