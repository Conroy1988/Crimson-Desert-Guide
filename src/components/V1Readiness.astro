---
import readiness from '../../data/v1-readiness.json';

const metricLabels: Record<string, string> = {
  guideRoutes: 'Guide routes',
  canonicalRecords: 'Canonical records',
  verifiedRecords: 'Verified records',
  researchRecords: 'Research records',
  completionMilestones: 'Completion milestones',
  guideDetailRecords: 'Quest & encounter details',
  catalogueRecords: 'Catalogue records',
  atlasLocations: 'Atlas locations',
  technicalRecords: 'Technical records',
  playableCharacters: 'Playable characters',
  buildArchetypes: 'Build archetypes',
  steamSections: 'Steam sections',
};
---

<section class="v1-readiness" aria-labelledby="v1-title">
  <header class="v1-hero">
    <div>
      <p class="v1-kicker">Release evidence · Patch {readiness.gamePatch}</p>
      <h2 id="v1-title">Guide v{readiness.guideVersion} Readiness</h2>
      <p>
        All planned guide programmes, tools and protected validation systems are present. Remaining partial game records are retained as a visible research queue rather than filled with unsupported answers.
      </p>
    </div>
    <div class="v1-score" aria-label={`${readiness.programmePercent}% programme completion`}>
      <span>{readiness.programmePercent}%</span>
      <strong>{readiness.status === 'ready' ? 'Release ready' : 'Blocked'}</strong>
      <small>Guide programme completion</small>
    </div>
  </header>

  <div class="v1-interpretation">
    <article>
      <span>Programme completion</span>
      <p>{readiness.interpretation.programmeCompletion}</p>
    </article>
    <article>
      <span>Evidence safety</span>
      <p>{readiness.interpretation.evidenceSafety}</p>
    </article>
    <article>
      <span>Ongoing game research</span>
      <p>{readiness.interpretation.gameExhaustiveness}</p>
    </article>
  </div>

  <section aria-labelledby="v1-programmes">
    <div class="v1-heading">
      <div><span>Programme matrix</span><h3 id="v1-programmes">Every major guide programme</h3></div>
      <p>{readiness.programmes.length} of {readiness.programmes.length} complete</p>
    </div>
    <div class="v1-programmes">
      {readiness.programmes.map((programme, index) => (
        <article>
          <div class="v1-programme__number">{String(index + 1).padStart(2, '0')}</div>
          <div>
            <h4>{programme.label}</h4>
            <p>{programme.checks.length} repository controls present</p>
          </div>
          <span class={`v1-state v1-state--${programme.status}`}>{programme.status}</span>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="v1-metrics">
    <div class="v1-heading">
      <div><span>Production inventory</span><h3 id="v1-metrics">What the release contains</h3></div>
      <p>Generated from the repository</p>
    </div>
    <dl class="v1-metrics">
      {Object.entries(readiness.metrics).map(([key, value]) => (
        <div>
          <dt>{metricLabels[key] ?? key}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="v1-research" aria-labelledby="v1-research">
    <div>
      <span>Explicit research queue</span>
      <h3 id="v1-research">{readiness.researchQueue.count} partial records remain visible</h3>
      <p>{readiness.researchQueue.explanation}</p>
    </div>
    <details>
      <summary>Show stable research IDs</summary>
      <div>{readiness.researchQueue.ids.map((id) => <code>{id}</code>)}</div>
    </details>
  </section>

  <section aria-labelledby="v1-deferred">
    <div class="v1-heading">
      <div><span>Deferred operations</span><h3 id="v1-deferred">Not content blockers</h3></div>
    </div>
    <div class="v1-deferred">
      {readiness.deferredOperations.map((operation) => <p>{operation}</p>)}
    </div>
  </section>

  <footer class="v1-footer">
    <div>
      <strong>Current conclusion</strong>
      <p>The guide is complete as an evidence-safe v1.0 platform for Patch {readiness.gamePatch}. Patch surveillance and the research queue continue after release.</p>
    </div>
    <nav aria-label="v1 readiness links">
      <a href="/standards/evidence-policy/">Evidence policy</a>
      <a href="/update-log/">Update Log</a>
      <a href="/technical/">Technical Centre</a>
    </nav>
  </footer>
</section>

<style>
  .v1-readiness { display: grid; gap: 1.5rem; }
  .v1-hero { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(15rem, .55fr); gap: 1.5rem; padding: clamp(1.5rem, 4vw, 2.8rem); border: 1px solid rgb(210 160 78 / 38%); border-radius: 1rem; background: radial-gradient(circle at 85% 10%, rgb(154 42 27 / 33%), transparent 38%), linear-gradient(135deg, #14120f, #070707); box-shadow: 0 1.8rem 4.5rem rgb(0 0 0 / 30%); }
  .v1-kicker { margin: 0; font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #d9aa5a !important; }
  .v1-hero h2 { margin: .3rem 0 .8rem; font-family: var(--cd-font-display); font-size: clamp(2.2rem, 5.6vw, 4.7rem); line-height: .94; color: #fff3dc; }
  .v1-hero p { max-width: 56rem; color: #cdbca1; }
  .v1-score { display: grid; place-content: center; min-height: 14rem; border: 1px solid rgb(217 168 85 / 35%); border-radius: 50%; aspect-ratio: 1; text-align: center; background: radial-gradient(circle, rgb(132 35 24 / 30%), rgb(0 0 0 / 35%) 65%); box-shadow: inset 0 0 0 .5rem rgb(211 159 75 / 5%); }
  .v1-score span { font-family: var(--cd-font-display); font-size: clamp(3rem, 7vw, 5.6rem); line-height: .9; color: #f3cd84; }
  .v1-score strong { margin-top: .45rem; color: #a5d2ac; }
  .v1-score small { margin-top: .2rem; font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; color: #a0937d; }
  .v1-interpretation { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .v1-interpretation article { padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .65rem; background: var(--sl-color-gray-6); }
  .v1-interpretation span, .v1-heading span, .v1-research > div > span { font-size: .63rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: #c49850; }
  .v1-interpretation p { margin: .4rem 0 0; }
  .v1-heading { display: flex; flex-wrap: wrap; gap: .8rem; align-items: end; justify-content: space-between; margin-bottom: .75rem; }
  .v1-heading h3, .v1-research h3 { margin: .1rem 0 0; font-family: var(--cd-font-display); font-size: 1.8rem; color: var(--sl-color-gray-1); }
  .v1-heading p { margin: 0; color: var(--sl-color-gray-2); }
  .v1-programmes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: .65rem; }
  .v1-programmes article { display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: center; padding: .8rem; border: 1px solid rgb(210 160 78 / 22%); border-radius: .6rem; background: linear-gradient(145deg, rgb(23 21 18 / 96%), rgb(10 10 9 / 98%)); }
  .v1-programme__number { font-family: var(--cd-font-display); font-size: 1.3rem; color: #b8873d; }
  .v1-programmes h4 { margin: 0; color: var(--sl-color-gray-1); }
  .v1-programmes p { margin: .15rem 0 0; font-size: .8rem; color: var(--sl-color-gray-3); }
  .v1-state { padding: .25rem .42rem; border-radius: 999px; font-size: .58rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .v1-state--complete { background: rgb(43 111 64 / 25%); color: #99cda5; }
  .v1-state--blocked { background: rgb(148 43 30 / 25%); color: #eb9387; }
  .v1-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .65rem; margin: 0; }
  .v1-metrics div { padding: .85rem; border: 1px solid var(--sl-color-gray-5); border-radius: .6rem; text-align: center; }
  .v1-metrics dt { font-size: .61rem; letter-spacing: .07em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .v1-metrics dd { margin: .2rem 0 0; font-family: var(--cd-font-display); font-size: 1.8rem; color: #dfb76b; }
  .v1-research { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1rem; padding: 1rem; border: 1px solid rgb(175 98 45 / 38%); border-radius: .7rem; background: rgb(119 65 31 / 12%); }
  .v1-research p { color: var(--sl-color-gray-2); }
  .v1-research details { align-self: center; }
  .v1-research summary { cursor: pointer; font-weight: 750; }
  .v1-research details div { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .7rem; max-height: 18rem; overflow: auto; }
  .v1-research code { font-size: .67rem; }
  .v1-deferred { display: grid; gap: .5rem; }
  .v1-deferred p { margin: 0; padding: .75rem; border-left: .2rem solid #886933; background: var(--sl-color-gray-6); }
  .v1-footer { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding: 1rem; border-top: 1px solid rgb(210 160 78 / 28%); }
  .v1-footer p { margin: .25rem 0 0; max-width: 50rem; }
  .v1-footer nav { display: flex; flex-wrap: wrap; gap: .7rem; }
  :global(:root[data-theme='light']) .v1-hero { border-color: #b99c70; background: radial-gradient(circle at 85% 10%, rgb(154 42 27 / 14%), transparent 38%), linear-gradient(135deg, #fffaf1, #ede0cc); box-shadow: 0 1.2rem 3rem rgb(91 55 32 / 15%); }
  :global(:root[data-theme='light']) .v1-hero h2 { color: #2d1b12; }
  :global(:root[data-theme='light']) .v1-hero p { color: #514032; }
  :global(:root[data-theme='light']) .v1-score { border-color: #ad8e5d; background: radial-gradient(circle, rgb(154 42 27 / 12%), rgb(255 253 249 / 75%) 65%); }
  :global(:root[data-theme='light']) .v1-score span { color: #653b08; }
  :global(:root[data-theme='light']) .v1-programmes article { border-color: #c1a477; background: linear-gradient(145deg, #fffdf8, #f0e4d2); }
  @media (max-width: 48rem) { .v1-hero { grid-template-columns: 1fr; } .v1-score { width: min(16rem, 100%); justify-self: center; } .v1-interpretation { grid-template-columns: 1fr; } .v1-research { grid-template-columns: 1fr; } }
  @media (max-width: 30rem) { .v1-programmes article { grid-template-columns: auto 1fr; } .v1-state { grid-column: 2; width: fit-content; } .v1-footer nav { display: grid; } }
</style>
